FUNCTION "LER_VirtualModuloPosition" : LReal
TITLE = FC_VirtualModuloPosition
{ S7_Optimized_Access := 'TRUE' ; Published := 'TRUE' }
VERSION : 0.1
//Calculates a PLC-side virtual modulo position from an accumulated servo actual position.
   VAR_INPUT 
      ActualPos : LReal;   // Accumulated actual position of the servo axis
      MinRange : LReal;   // Lower limit of the virtual modulo range
      MaxRange : LReal;   // Upper limit of the virtual modulo range
   END_VAR

   VAR_TEMP 
      tempSpan : LReal;
      tempOffset : LReal;
      tempWrapped : LReal;
   END_VAR


BEGIN
	// Calculate virtual modulo span
	#tempSpan := #MaxRange - #MinRange;
	
	// Handle invalid range with a deterministic fallback
	IF #tempSpan <= 0.0 THEN
	    #LER_VirtualModuloPosition := #MinRange;
	ELSE
	    // Shift actual position to a zero based range
	    #tempOffset := #ActualPos - #MinRange;
	
	    // Modulo equivalent using TRUNC for LREAL values
	    #tempWrapped := #tempOffset - (DINT_TO_LREAL(TRUNC(#tempOffset / #tempSpan)) * #tempSpan);
	
	    // Correct negative remainder after modulo calculation
	    IF #tempWrapped < 0.0 THEN
	        #tempWrapped := #tempWrapped + #tempSpan;
	    END_IF;
	
	    // Shift wrapped value back into the requested range
	    #LER_VirtualModuloPosition := #tempWrapped + #MinRange;
	
	    // Keep upper limit exclusive after rounding effects
	    IF #LER_VirtualModuloPosition >= #MaxRange THEN
	        #LER_VirtualModuloPosition := #LER_VirtualModuloPosition - #tempSpan;
	    END_IF;
	
	    // Protect lower limit after precision effects
	    IF #LER_VirtualModuloPosition < #MinRange THEN
	        #LER_VirtualModuloPosition := #LER_VirtualModuloPosition + #tempSpan;
	    END_IF;
	END_IF;
END_FUNCTION

