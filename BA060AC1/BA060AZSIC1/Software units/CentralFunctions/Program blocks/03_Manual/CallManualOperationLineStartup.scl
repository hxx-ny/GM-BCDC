	     "ManualOperationControl_U1Em8".manualOperationEmArea[1].displayedLines := '21-27;';
	END_REGION
	
	REGION Unit 1 Equipment Module 9 configuration
	    "ManualOperationControl_U1Em9".manualOperationEm.equipmentModuleNum := 1100;
	    "ManualOperationControl_U1Em9".manualOperationEmArea[2].displayedLines := '1-;';
	    "ManualOperationControl_U1Em9".manualOperationEmArea[1].displayedLines := '21-22;';
	END_REGION
