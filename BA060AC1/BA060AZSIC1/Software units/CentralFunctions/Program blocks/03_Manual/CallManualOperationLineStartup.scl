	    "ManualOperationControl_U1Em11".manualOperationEmArea[1].displayedLines := '21-22;';
	END_REGION
	
	REGION Unit 1 Equipment Module 12 configuration
	    "ManualOperationControl_U1Em12".manualOperationEm.equipmentModuleNum := 1130;
	    "ManualOperationControl_U1Em12".manualOperationEmArea[2].displayedLines := '1-;';
	    "ManualOperationControl_U1Em12".manualOperationEmArea[1].displayedLines := '21-27;';
	END_REGION
	
