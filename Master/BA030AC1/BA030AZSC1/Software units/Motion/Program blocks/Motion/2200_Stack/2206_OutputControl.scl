	        #statAnodePnP1Suction := FALSE;
	        #statAnodePnP1Blow := FALSE;
	        #statAnodePnP1ReelCutBlow := FALSE;
	        #statAnodePnP2Suction := FALSE;
	        #statAnodePnP2Blow := FALSE;
	        #statAnodeAlignSuction := FALSE;
	        #statAnodeAlignBlow := FALSE;
	        #statAnodePnP1RotaryWork := FALSE;
	        #statAnodePnP1RotaryHome := FALSE;
	        #statAnodeReelCutDataDelete := FALSE;
	        #statAnodeAlignVision := FALSE;
	        #statCathodePnP1Suction := FALSE;
	        #statCathodePnP1Blow := FALSE;
	        #statCathodePnP1ReelCutBlow := FALSE;
	        #statCathodePnP2Suction := FALSE;
	        #statCathodePnP2Blow := FALSE;
	        #statCathodeAlignSuction := FALSE;
	        #statCathodeAlignBlow := FALSE;
	        #statCathodePnP1RotaryWork := FALSE;
	        #statCathodePnP1RotaryHome := FALSE;
	        #statCathodeReelCutDataDelete := FALSE;
	        #statCathodeAlignVision := FALSE;
	        #statStackTableZAnodeDown := FALSE;
	        #statStackTableZCathodeDown := FALSE;
	        #statStackAnodeVision := FALSE;
	        #statStackCathodeVision := FALSE;
	    END_IF;
