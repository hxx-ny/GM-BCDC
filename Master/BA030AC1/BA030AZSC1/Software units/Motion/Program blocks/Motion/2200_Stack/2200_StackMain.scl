         CathodePnPX1BwdOutputCam : DB_ANY;
         CathodePnPX2FwdOutputCam : DB_ANY;
         CathodePnPX2BwdOutputCam : DB_ANY;
         CathodePnPZ1Down1OutputCam : DB_ANY;
         CathodePnPZ1Up1OutputCam : DB_ANY;
         CathodePnPZ2Down1OutputCam : DB_ANY;
         CathodePnPZ2Up1OutputCam : DB_ANY;
         CathodePnPZ1Down2OutputCam : DB_ANY;
         CathodePnPZ1Up2OutputCam : DB_ANY;
         CathodePnPZ2Down2OutputCam : DB_ANY;
         CathodePnPZ2Up2OutputCam : DB_ANY;
         CathodePnPZ1SuctionOnOutputCam : DB_ANY;
         CathodePnPZ1SuctionOffOutputCam : DB_ANY;
         CathodePnPZ1ReelCutBlowOutputCam : DB_ANY;
