   VAR 
      statNowCmd : DInt;
      statBeforeCmd : DInt;
      statDone : Bool;
      statTimeTable : Array[1..50] of Time;
      statStartTime : Time;
      statEndTime : Time;
      instTriggerCalculate {InstructionName := 'R_TRIG'; LibVersion := '1.0'; S7_SetPoint := 'False'} : R_TRIG;
      instTriggerSemiStep {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      instTriggerFullStep {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      instTriggerAuto {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      instTriggerStop {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      instTriggerReset {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      instStackSemiStep : "2202_StackSemiStep";
      instStackFullStepAuto : "2203_StackFullStepAuto";
      instStackStop : "2204_StackStop";
      instStackReset : "2205_StackReset";
      instOutputControl : "2206_OutputControl";
   END_VAR

   VAR_TEMP 
      tempMasterVirtual {InstructionName := 'TO_SynchronousAxis'; LibVersion := '9.0'} : REF_TO TO_SynchronousAxis;
   END_VAR

   VAR CONSTANT 
      STAT_IDLE : DInt := 0;
      STAT_CALCULATE : DInt := 1;
      STAT_SEMI_STEP : DInt := 2;
      STAT_FULL_STEP : DInt := 3;
      STAT_AUTO : DInt := 4;
      STAT_STOP : DInt := 10;
      STAT_RESET : DInt := 12;
      STAT_DONE : DInt := 10000;
      STAT_ERROR : DInt := 99;
   END_VAR


BEGIN
	REGION INPUT SIGNAL
	    REGION CALCULATE                                                 // Cam Calculate 동작 영역
	        #instTriggerCalculate(CLK := #Calculate);                    // 상승 에지 검출
	        
	        IF #instTriggerCalculate.Q AND #statNowCmd = #STAT_IDLE THEN // STAT_IDLE 상태에서 상승 에지 검출 시 동작
	            #statStartTime := TIME_TCK();
	            #statBeforeCmd := #statNowCmd;                           // 이전 명령 모니터링
	            #statNowCmd := #STAT_CALCULATE;                          // STAT_CALCULATE 상태 돌입
	            #statDone := FALSE;                                      // 동작 완료 신호 초기화
	        END_IF;
	    END_REGION
	    
	    REGION SEMI STEP                                                 // Step 동작 영역
	        #instTriggerSemiStep(CLK := #SemiStep);                      // 상승 에지 검출
	        
	        IF #instTriggerSemiStep.Q AND #statNowCmd = #STAT_IDLE THEN  // STAT_IDLE 상태에서 상승 에지 검출 시 동작
	            #statStartTime := TIME_TCK();
	            #instStackFullStepAuto.Auto := FALSE;                    // Auto 모드 해제
	            #statBeforeCmd := #statNowCmd;                           // 이전 명령 모니터링
	            #statNowCmd := #STAT_SEMI_STEP;                          // STAT_SEMI_STEP 상태로 이동
	            #statDone := FALSE;                                      // 동작 완료 신호 초기화
	        END_IF;
	    END_REGION
	    
	    REGION FULL STEP                                                 // Full Step 동작 영역
	        #instTriggerFullStep(CLK := #FullStep);                      // 상승 에지 검출
	        
	        IF #instTriggerFullStep.Q AND #statNowCmd = #STAT_IDLE THEN  // STAT_IDLE 상태에서 상승 에지 검출 시 동작
	            #statStartTime := TIME_TCK();
	            #instStackFullStepAuto.Auto := FALSE;                    // Auto 모드 해제
	            #statBeforeCmd := #statNowCmd;                           // 이전 명령 모니터링
	            #statNowCmd := #STAT_FULL_STEP;                          // STAT_FULL_STEP 상태 돌입
	            #statDone := FALSE;                                      // 동작 완료 신호 초기화
	        END_IF;
	    END_REGION
	    
	    REGION AUTO                                                      // Auto 동작 영역
	        #instTriggerAuto(CLK := #Auto);                              // 상승 에지 검출
	        
	        IF #instTriggerAuto.Q AND #statNowCmd = #STAT_IDLE THEN      // STAT_IDLE 상태에서 상승 에지 검출 시 동작
	            #statStartTime := TIME_TCK();
	            #instStackFullStepAuto.Auto := TRUE;                     // Auto 모드 입력
	            #statBeforeCmd := #statNowCmd;                           // 이전 명령 모니터링
	            #statNowCmd := #STAT_AUTO;                               // STAT_AUTO 상태로 이동
	            #statDone := FALSE;                                      // 동작 완료 신호 초기화
	        END_IF;
	    END_REGION
	    
	    REGION STOP                                                      // Stop 동작 영역
	        #instTriggerStop(CLK := #CycleStop OR #FastStop);                              // 상승 에지 검출
	        
	        IF #instTriggerStop.Q AND #statNowCmd <> #STAT_STOP THEN     // STAT_STOP이 아닐 때 상승 에지 검출 시 동작
	            #statStartTime := TIME_TCK();
	            #instStackStop.FastStop := #FastStop;
	            #statBeforeCmd := #statNowCmd;                           // 이전 명령 모니터링
	            #statNowCmd := #STAT_STOP;                               // STAT_STOP 상태로 이동
	            #statDone := FALSE;                                      // 동작 완료 신호 초기화
	        END_IF;
	    END_REGION
	    
	    REGION RESET                                                     // Reset 동작 영역
	        #instTriggerReset(CLK := #Reset);                            // 상승 에지 검출
	        
	        IF #instTriggerReset.Q AND #statNowCmd = #STAT_ERROR THEN    // STAT_ERROR 상태에서 상승 에지 검출 시 동작
	            #statStartTime := TIME_TCK();
	            #statBeforeCmd := #statNowCmd;                           // 이전 명령 모니터링
	            #statNowCmd := #STAT_RESET;                              // STAT_RESET 상태로 이동
	            #statDone := FALSE;                                      // 동작 완료 신호 초기화
	        END_IF;
	    END_REGION
	END_REGION
	
	REGION COMMAND                                                       // 각 커맨드에 따른 Done 및 Error 신호 처리
	    CASE #statNowCmd OF
	        #STAT_IDLE:
	            REGION IDLE
	                ;
	            END_REGION
	            
	        #STAT_CALCULATE:                                             // STAT_Caculate 상태
	            REGION CALCULATE                                  
	                REGION DONE                                          // Calculate 동작 완료 시 
	                    IF #CalculateInterface.Done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_CALCULATE] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_DONE;                   // STAT_IDLE 상태로 이동
	                        #statDone := TRUE;                           // 동작 완료 신호 출력
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                         // Calculate 동작 중 에러 발생 시
	                    IF #CalculateInterface.Error THEN
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                  // STAT_ERROR 상태로 이동
	                        #ErrorID := #CalculateInterface.ErrorID;     // Calculate 에러ID 출력
	                    END_IF;
	                END_REGION
	                
	                #SubBeforeStep := #CalculateInterface.BeforeCmd;     // 이전 스텝 모니터링
	                #SubNowStep := #CalculateInterface.NowCmd;           // 현재 스텝 모니터링
	            END_REGION
	            
	        #STAT_SEMI_STEP:                                             // Semi Step 동작 영역                                    
	            REGION SEMI STEP
	                REGION DONE                                          // Semi Step 동작 완료 시
	                    IF #instStackSemiStep.Done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_SEMI_STEP] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_DONE;                   // STAT_IDLE 상태로 이동
	                        #statDone := TRUE;                           // 동작 완료 신호 출력
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                         // Semi Step 동작 중 에러 발생 시
	                    IF #instStackSemiStep.Error THEN
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                  // STAT_ERROR 상태로 이동
	                        #ErrorID := #instStackSemiStep.ErrorID;      // Semi Step 에러ID 출력
	                    END_IF;
	                    
	                    IF #instOutputControl.Error THEN
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                  // STAT_ERROR 상태로 이동
	                        #ErrorID := #instOutputControl.ErrorID;      // 에러ID 출력
	                    END_IF;
	                END_REGION
	                
	                #SubBeforeStep := #instStackSemiStep.BeforeCmd;      // 이전 스텝 모니터링
	                #SubNowStep := #instStackSemiStep.NowCmd;            // 현재 스텝 모니터링
	            END_REGION
	            
	        #STAT_FULL_STEP:                                             // Full Step 동작 영역
	            REGION FULL STEP
	                REGION DONE                                          // Full Step 동작 완료 시
	                    IF #instStackFullStepAuto.Done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_FULL_STEP] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_DONE;                   // STAT_IDLE 상태로 이동
	                        #statDone := TRUE;                           // 동작 완료 신호 출력
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                         // Full Step 동작 중 에러 발생 시
	                    IF #instStackFullStepAuto.Error THEN             // Full Step 에러 신호 발생 시
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                  // STAT_ERROR 상태로 이동
	                        #ErrorID := #instStackFullStepAuto.ErrorID;  // Full Step 에러ID 출력
	                    END_IF;
	                    
	                    IF #instOutputControl.Error THEN
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                  // STAT_ERROR 상태로 이동
	                        #ErrorID := #instOutputControl.ErrorID;      // 에러ID 출력
	                    END_IF;
	                END_REGION
	                
	                #SubBeforeStep := #instStackFullStepAuto.BeforeCmd;  // 이전 스텝 모니터링
	                #SubNowStep := #instStackFullStepAuto.NowCmd;        // 현재 스텝 모니터링
	            END_REGION
	            
	        #STAT_AUTO:                                                  // Auto 동작 영역
	            REGION AUTO
	                REGION DONE                                          // Auto 동작 완료 시
	                    IF #instStackFullStepAuto.Done THEN              // Auto 완료 신호 발생 시
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_AUTO] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_DONE;                   // STAT_IDLE 상태로 이동
	                        #statDone := TRUE;                           // 동작 완료 신호 출력
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                         // Auto 동작 중 에러 발생 시
	                    IF #instStackFullStepAuto.Error THEN             // Auto 에러 신호 발생 시
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                  // STAT_ERROR 상태로 이동
	                        #ErrorID := #instStackFullStepAuto.ErrorID;  // Auto 에러ID 출력
	                    END_IF;
	                    
	                    IF #instOutputControl.Error THEN
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                  // STAT_ERROR 상태로 이동
	                        #ErrorID := #instOutputControl.ErrorID;      // 에러ID 출력
	                    END_IF;
	                END_REGION
	                
	                #SubBeforeStep := #instStackFullStepAuto.BeforeCmd;  // 이전 스텝 모니터링
	                #SubNowStep := #instStackFullStepAuto.NowCmd;        // 현재 스텝 모니터링
	            END_REGION
	            
	        #STAT_STOP:                                                  // Stop 동작 영역
	            REGION STOP
	                REGION DONE                                          // Stop 동작 완료 시
	                    IF #instStackStop.Done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_STOP] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_DONE;                   // STAT_IDLE 상태로 이동
	                        #statDone := TRUE;                           // 동작 완료 신호 출력
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                         // Stop 동작 중 에러 발생 시
	                    IF #instStackStop.Error THEN
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                  // STAT_ERROR 상태로 이동
	                        #ErrorID := #instStackStop.ErrorID;          // Stop 에러ID 출력
	                    END_IF;
	                END_REGION
	                
	                #SubBeforeStep := #instStackStop.BeforeCmd;          // 이전 스텝 모니터링
	                #SubNowStep := #instStackStop.NowCmd;                // 현재 스텝 모니터링
	            END_REGION
	            
	        #STAT_RESET:
	            REGION RESET                                             // Reset 동작 영역
	                REGION DONE 
	                    IF #instStackReset.Done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_RESET] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_DONE;                   // STAT_IDLE 상태로 이동
	                        #statDone := TRUE;                           // 동작 완료 신호 출력
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                         // Reset 동작 중 에러 발생 시
	                    IF #instStackReset.Error THEN
	                        #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                  // STAT_ERROR 상태로 이동
	                        #ErrorID := #instStackReset.ErrorID;         // Reset 에러ID 출력
	                    END_IF;
	                END_REGION
	                
	                #SubBeforeStep := #instStackReset.BeforeCmd;         // 이전 스텝 모니터링
	                #SubNowStep := #instStackReset.NowCmd;               // 현재 스텝 모니터링
	            END_REGION
	            
	        #STAT_DONE:
	            REGION DONE
	                IF NOT #Calculate
	                    AND NOT #SemiStep
	                    AND NOT #FullStep
	                    AND NOT #Auto
	                    AND NOT #CycleStop
	                    AND NOT #FastStop
	                    AND NOT #Reset
	                THEN
	                    #statEndTime := TIME_TCK();
	                    #statTimeTable[#STAT_DONE / 200] := #statEndTime - #statStartTime;
	                    #statStartTime := TIME_TCK();
	                    #statBeforeCmd := #statNowCmd;               // 이전 명령 모니터링
	                    #statNowCmd := #STAT_IDLE;                  // #STAT_IDLE 상태로 이동
	                END_IF;
	            END_REGION
	    END_CASE;
	END_REGION
	
	REGION INSTANCES                                                     // 각 커맨드에 따른 인스턴스DB 호출 영역
	    REGION SEMI STEP
	        #instStackSemiStep(Execute := #statNowCmd = #STAT_SEMI_STEP,
	                           MandrelUse:=#Parameter.Step.MandrelUse,
	                           CPM := #Parameter.Global.CPM,
	                           StageWidth := #Parameter.Global.StageWidth,
	                           Axis:=#Axis,
	                           Cam:=#Cam,
	                           InitialPosFinalRoller := #Parameter.Step.InitialPosFinalRoller,
	                           InitialPosCompensator := #Parameter.Step.InitialPosCompensator,
	                           InitialPosAnodeMandrelYFront:=#Parameter.Auto.Mandrel.InitialPosAnodeMandrelYFront,
	                           InitialPosAnodeMandrelYRear:=#Parameter.Auto.Mandrel.InitialPosAnodeMandrelYRear,
	                           InitialPosAnodeMandrelZFront:=#Parameter.Auto.Mandrel.InitialPosAnodeMandrelZFront,
	                           InitialPosAnodeMandrelZRear:=#Parameter.Auto.Mandrel.InitialPosAnodeMandrelZRear,
	                           InitialPosCathodeMandrelYFront:=#Parameter.Auto.Mandrel.InitialPosCathodeMandrelYFront,
	                           InitialPosCathodeMandrelYRear:=#Parameter.Auto.Mandrel.InitialPosCathodeMandrelYRear,
	                           InitialPosCathodeMandrelZFront:=#Parameter.Auto.Mandrel.InitialPosCathodeMandrelZFront,
	                           InitialPosCathodeMandrelZRear:=#Parameter.Auto.Mandrel.InitialPosCathodeMandrelZRear);
	    END_REGION
	    
	    REGION FULL STEP AUTO
	        #instStackFullStepAuto(Execute := #statNowCmd = #STAT_FULL_STEP OR #statNowCmd = #STAT_AUTO,
	                               SepaClean := #Parameter.Auto.SepaClean,
	                               Direction := #Parameter.StackCalculate.Direction,
	                               CPM := #Parameter.Global.CPM,
	                               StageWidth := #Parameter.Global.StageWidth,
	                               CellCount := #Parameter.Auto.CellCount,
	                               Axis := #Axis,
	                               Cam := #Cam,
	                               CamOutput := #instOutputControl.CamOutput,
	                               ReelCutInterface := #ReelcutInterface,
	                               InitialPosFinalRoller := #Parameter.Auto.FinalRoller.InitialPosFinalRoller,
	                               InitialPosCompensator := #Parameter.Auto.Compensator.InitialPosCompensator,
	                               InitialPosAnodePnPX1 := #Parameter.Auto.Anode.PnPX1.InitialPosAnodePnPX1,
	                               InitialPosAnodePnPX2 := #Parameter.Auto.Anode.PnPX2.InitialPosAnodePnPX2,
	                               InitialPosAnodePnPZ1 := #Parameter.Auto.Anode.PnPZ1.InitialPosAnodePnPZ1,
	                               InitialPosAnodePnPZ2 := #Parameter.Auto.Anode.PnPZ2.InitialPosAnodePnPZ2,
	                               InitialPosCathodePnPX1 := #Parameter.Auto.Cathode.PnPX1.InitialPosCathodePnPX1,
	                               InitialPosCathodePnPX2 := #Parameter.Auto.Cathode.PnPX2.InitialPosCathodePnPX2,
	                               InitialPosCathodePnPZ1 := #Parameter.Auto.Cathode.PnPZ1.InitialPosCathodePnPZ1,
	                               InitialPosCathodePnPZ2 := #Parameter.Auto.Cathode.PnPZ2.InitialPosCathodePnPZ2,
	                               InitialPosAnodeMandrelYFront := #Parameter.Auto.Mandrel.InitialPosAnodeMandrelYFront,
	                               InitialPosAnodeMandrelYRear := #Parameter.Auto.Mandrel.InitialPosAnodeMandrelYRear,
	                               InitialPosAnodeMandrelZFront := #Parameter.Auto.Mandrel.InitialPosAnodeMandrelZFront,
	                               InitialPosAnodeMandrelZRear := #Parameter.Auto.Mandrel.InitialPosAnodeMandrelZRear,
	                               InitialPosCathodeMandrelYFront := #Parameter.Auto.Mandrel.InitialPosCathodeMandrelYFront,
	                               InitialPosCathodeMandrelYRear := #Parameter.Auto.Mandrel.InitialPosCathodeMandrelYRear,
	                               InitialPosCathodeMandrelZFront := #Parameter.Auto.Mandrel.InitialPosCathodeMandrelZFront,
	                               InitialPosCathodeMandrelZRear := #Parameter.Auto.Mandrel.InitialPosCathodeMandrelZRear);
	    END_REGION
	    
	    REGION STOP
	        #instStackStop(Execute := #statNowCmd = #STAT_STOP,
	                       Auto := #instStackFullStepAuto.Auto,
	                       CPM := #Parameter.Global.CPM,
	                       StageWidth := #Parameter.Global.StageWidth,
	                       Axis:= #Axis);
	    END_REGION
	    
	    REGION RESET
	        #instStackReset(Execute := #statNowCmd = #STAT_RESET,
	                        CPM := #Parameter.Global.CPM,
	                        StageWidth := #Parameter.Global.StageWidth,
	                        Axis:= #Axis,
	                        Cam:= #Cam,
	                        OutputCam:= #OutputCam);
	    END_REGION
	END_REGION
	
	
	REGION OUTPUTCAMS
	    #instOutputControl(Execute := #statNowCmd = #STAT_FULL_STEP
	                       OR #statNowCmd = #STAT_AUTO
	                       OR #statNowCmd = #STAT_SEMI_STEP
	                       OR #statNowCmd = #STAT_STOP,
	                       Anode:= #Parameter.Auto.Anode,
	                       Cathode:= #Parameter.Auto.Cathode,
	                       FinalRoller:= #Parameter.Auto.FinalRoller,
	                       Output=> #OutputBits,
	                       Axis := #Axis,
	                       Cam := #Cam,
	                       OutputCam := #OutputCam);
	END_REGION
	
	
	
	REGION OUTPUT SIGNAL // 각 커맨드 동작 시 상태 표시 출력
	    #Busy.TotalBusy := #statNowCmd = #STAT_CALCULATE OR #statNowCmd = #STAT_SEMI_STEP OR #statNowCmd = #STAT_FULL_STEP OR #statNowCmd = #STAT_AUTO OR #statNowCmd = #STAT_STOP OR #statNowCmd = #STAT_RESET;
	    #CalculateInterface.Execute := #statNowCmd = #STAT_CALCULATE;
	    #Busy.CalculateBusy := #CalculateInterface.Busy;
	    #Busy.SemiStepBusy := #instStackSemiStep.Busy;
	    #Busy.FullStepBusy := #instStackFullStepAuto.Busy AND NOT #instStackFullStepAuto.Auto;
	    #Busy.AutoBusy := #instStackFullStepAuto.Busy AND #instStackFullStepAuto.Auto;
	    #Busy.CycleStopBusy := #instStackStop.Busy AND NOT #instStackStop.FastStop;
	    #Busy.FastStopBusy := #instStackStop.Busy AND #instStackStop.FastStop;
	    #Busy.ResetBusy := #instStackReset.Busy;
	    
	    #Done.TotalDone := #statNowCmd = #STAT_DONE;
	    #Done.CalculateDone := #Calculate AND #statNowCmd = #STAT_DONE;
	    #Done.SemiStepDone := #SemiStep AND #statNowCmd = #STAT_DONE;
	    #Done.FullStepDone := #FullStep AND #statNowCmd = #STAT_DONE;
	    #Done.AutoDone := #Auto AND #statNowCmd = #STAT_DONE;
	    #Done.CycleStopDone := #CycleStop AND #statNowCmd = #STAT_DONE;
	    #Done.FastStopDone := #FastStop AND #statNowCmd = #STAT_DONE;
	    #Done.ResetDone := #Reset AND #statNowCmd = #STAT_DONE;
	    
	    #Error := #statNowCmd = #STAT_ERROR;
	    #tempMasterVirtual ?= #Axis.MasterVirtual;
	    #OutputData.StackCellCount := LREAL_TO_DINT(FLOOR_LREAL(#tempMasterVirtual^.Position / #Parameter.Global.StageWidth));
	END_REGION
	
END_FUNCTION_BLOCK

