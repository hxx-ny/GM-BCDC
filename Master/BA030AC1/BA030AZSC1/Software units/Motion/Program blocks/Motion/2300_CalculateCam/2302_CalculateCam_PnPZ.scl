	                    #tempCalVel[25] := #tempJerk[25 - 1] * #tempX[25 - 1] * #tempX[25 - 1] / 2.0 + #tempCalAcc[25 - 1] * #tempX[25 - 1] + #tempCalVel[25 - 1];
	                    #tempCalPos[25] := #tempJerk[25 - 1] * #tempX[25 - 1] * #tempX[25 - 1] * #tempX[25 - 1] / 6.0 + #tempCalAcc[25 - 1] * #tempX[25 - 1] * #tempX[25 - 1] / 2.0 + #tempCalVel[25 - 1] * #tempX[25 - 1] + #tempCalPos[25 - 1];
	                    IF ABS_LREAL(#tempCalVel[25]) < 0.000000001 THEN
	                        #tempCalVel[25] := 0.0;
	                    END_IF;
	                    IF ABS_LREAL(#tempCalPos[25]) < 0.000000001 THEN
	                        #tempCalPos[25] := 0.0;
	                    END_IF;
	                    #tempA3[25] := #tempJerk[25] / 6.0;
	                    #tempA2[25] := #tempCalAcc[25] / 2.0;
	                    #tempA1[25] := #tempCalVel[25];
	                    #tempA0[25] := #tempCalPos[25];
	                    #tempCam^.Segment[25].a0 := #tempA0[25];
	                    #tempCam^.Segment[25].a1 := #tempA1[25];
	                    #tempCam^.Segment[25].a2 := #tempA2[25];
	                    #tempCam^.Segment[25].a3 := #tempA3[25];
	                    #tempCam^.Segment[25].a4 := 0.0;
	                    #tempCam^.Segment[25].a5 := 0.0;
	                    #tempCam^.Segment[25].a6 := 0.0;
	                    #tempCam^.Segment[25].xmax := #tempCam^.Segment[25 - 1].xmax + #tempX[25];
	                    #tempCam^.Segment[25].xmin := #tempCam^.Segment[25 - 1].xmax;
	                    #tempCam^.Segment[25].sineAmplitude := 0.0;
	                    #tempCam^.Segment[25].sinePeriod := 0.0;
	                    #tempCam^.Segment[25].sinePhase := 0.0;
	                    IF #tempX[25] = 0.0 THEN
	                        #tempCam^.ValidSegment[25] := FALSE;
	                    ELSE
	                        #tempCam^.ValidSegment[25] := TRUE;
	                    END_IF;
	                    
	                    // ==============================================================================
	                    // Segment [26]
	                    // ============================================================================== 
	                    #tempCalAcc[26] := #tempJerk[26 - 1] * #tempX[26 - 1] + #tempCalAcc[26 - 1];
	                    #tempCalVel[26] := #tempJerk[26 - 1] * #tempX[26 - 1] * #tempX[26 - 1] / 2.0 + #tempCalAcc[26 - 1] * #tempX[26 - 1] + #tempCalVel[26 - 1];
	                    #tempCalPos[26] := #tempJerk[26 - 1] * #tempX[26 - 1] * #tempX[26 - 1] * #tempX[26 - 1] / 6.0 + #tempCalAcc[26 - 1] * #tempX[26 - 1] * #tempX[26 - 1] / 2.0 + #tempCalVel[26 - 1] * #tempX[26 - 1] + #tempCalPos[26 - 1];
	                    IF ABS_LREAL(#tempCalVel[26]) < 0.000000001 THEN
	                        #tempCalVel[26] := 0.0;
	                    END_IF;
	                    IF ABS_LREAL(#tempCalPos[26]) < 0.000000001 THEN
	                        #tempCalPos[26] := 0.0;
	                    END_IF;
	                    #tempA3[26] := #tempJerk[26] / 6.0;
	                    #tempA2[26] := #tempCalAcc[26] / 2.0;
	                    #tempA1[26] := #tempCalVel[26];
	                    #tempA0[26] := #tempCalPos[26];
	                    #tempCam^.Segment[26].a0 := #tempA0[26];
	                    #tempCam^.Segment[26].a1 := #tempA1[26];
	                    #tempCam^.Segment[26].a2 := #tempA2[26];
	                    #tempCam^.Segment[26].a3 := #tempA3[26];
	                    #tempCam^.Segment[26].a4 := 0.0;
	                    #tempCam^.Segment[26].a5 := 0.0;
	                    #tempCam^.Segment[26].a6 := 0.0;
	                    #tempCam^.Segment[26].xmax := #tempCam^.Segment[26 - 1].xmax + #tempX[26];
	                    #tempCam^.Segment[26].xmin := #tempCam^.Segment[26 - 1].xmax;
	                    #tempCam^.Segment[26].sineAmplitude := 0.0;
	                    #tempCam^.Segment[26].sinePeriod := 0.0;
	                    #tempCam^.Segment[26].sinePhase := 0.0;
	                    IF #tempX[26] = 0.0 THEN
	                        #tempCam^.ValidSegment[26] := FALSE;
	                    ELSE
	                        #tempCam^.ValidSegment[26] := TRUE;
	                    END_IF;
	                    
	                    // ==============================================================================
	                    // Segment [27]
	                    // ============================================================================== 
	                    #tempCalAcc[27] := #tempJerk[27 - 1] * #tempX[27 - 1] + #tempCalAcc[27 - 1];
	                    #tempCalVel[27] := #tempJerk[27 - 1] * #tempX[27 - 1] * #tempX[27 - 1] / 2.0 + #tempCalAcc[27 - 1] * #tempX[27 - 1] + #tempCalVel[27 - 1];
	                    #tempCalPos[27] := #tempJerk[27 - 1] * #tempX[27 - 1] * #tempX[27 - 1] * #tempX[27 - 1] / 6.0 + #tempCalAcc[27 - 1] * #tempX[27 - 1] * #tempX[27 - 1] / 2.0 + #tempCalVel[27 - 1] * #tempX[27 - 1] + #tempCalPos[27 - 1];
	                    IF ABS_LREAL(#tempCalVel[27]) < 0.000000001 THEN
	                        #tempCalVel[27] := 0.0;
	                    END_IF;
	                    IF ABS_LREAL(#tempCalPos[27]) < 0.000000001 THEN
	                        #tempCalPos[27] := 0.0;
	                    END_IF;
	                    #tempA3[27] := #tempJerk[27] / 6.0;
	                    #tempA2[27] := #tempCalAcc[27] / 2.0;
	                    #tempA1[27] := #tempCalVel[27];
	                    #tempA0[27] := #tempCalPos[27];
	                    #tempCam^.Segment[27].a0 := #tempA0[27];
	                    #tempCam^.Segment[27].a1 := #tempA1[27];
	                    #tempCam^.Segment[27].a2 := #tempA2[27];
	                    #tempCam^.Segment[27].a3 := #tempA3[27];
	                    #tempCam^.Segment[27].a4 := 0.0;
	                    #tempCam^.Segment[27].a5 := 0.0;
	                    #tempCam^.Segment[27].a6 := 0.0;
	                    #tempCam^.Segment[27].xmax := #tempCam^.Segment[27 - 1].xmax + #tempX[27];
	                    #tempCam^.Segment[27].xmin := #tempCam^.Segment[27 - 1].xmax;
	                    #tempCam^.Segment[27].sineAmplitude := 0.0;
	                    #tempCam^.Segment[27].sinePeriod := 0.0;
	                    #tempCam^.Segment[27].sinePhase := 0.0;
	                    IF #tempX[27] = 0.0 THEN
	                        #tempCam^.ValidSegment[27] := FALSE;
	                    ELSE
	                        #tempCam^.ValidSegment[27] := TRUE;
	                    END_IF;
	                END_REGION
	                
	                #statEndTime := TIME_TCK();
	                #statTimeTable[#CC_CALCULATE] := #statEndTime - #statStartTime;
	                #statStartTime := TIME_TCK();
	                #statCalculateCamState := #CC_INTERPOLATE;
	            END_REGION
	            
	        #CC_INTERPOLATE:
	            REGION INTERPOLATE
	                IF #instMCInterpolateCam.Done
	                THEN
	                    #statEndTime := TIME_TCK();
	                    #statTimeTable[#CC_INTERPOLATE] := #statEndTime - #statStartTime;
	                    #statStartTime := TIME_TCK();
	                    #statCalculateCamState := #CC_DONE;
	                END_IF;
	            END_REGION
	            
	        #CC_DONE:
	            REGION DONE
	                ;
	            END_REGION
	            
	        #CC_ERROR:
	            REGION ERROR
	                ;
	            END_REGION
	    END_CASE;
	END_REGION
	
	REGION Instance
	    #instMCInterpolateCam(Cam := #tempCam^,
	                          Execute := #statCalculateCamState = #CC_INTERPOLATE);
	    #instMCCopyCamData(Cam := #tempCam^,
	                       Execute := #statCalculateCamState = #CC_INITIALIZE1 OR #statCalculateCamState = #CC_INITIALIZE3,
	                       Mode := 0,
	                       StartPointCam := 1,
	                       StartSegmentCam := 1,
	                       StartPointArray := 1,
	                       StartSegmentArray := 1,
	                       ArrayOfPoints := #EmptyPoint,
	                       ArrayOfSegments := #EmptySegment);
	END_REGION
	
	REGION Outputs
	    #busy := #statCalculateCamState = #CC_INITIALIZE1
	    OR #statCalculateCamState = #CC_INITIALIZE2
	    OR #statCalculateCamState = #CC_INITIALIZE3
	    OR #statCalculateCamState = #CC_CALCULATE
	    OR #statCalculateCamState = #CC_INTERPOLATE;
	    #error := #statCalculateCamState = #CC_ERROR;
	    #done := #statCalculateCamState = #CC_DONE;
	END_REGION
END_FUNCTION_BLOCK

