FUNCTION_BLOCK "2302_CalculateCam_PnPZ"
{ S7_Optimized_Access := 'TRUE' ; Published := 'FALSE' }
VERSION : 0.1
   VAR_INPUT 
      execute : Bool;
      cpm : LReal;
      distance1 : LReal;
      distance2 : LReal;
      lineSpeed : LReal;
      ratioOption : Bool;
      downStartRatio : LReal;
      downEndRatio : LReal;
      upStartRatio : LReal;
      upEndRatio : LReal;
      timeOption : Bool;
      downStartTime : LReal;
      downEndTime : LReal;
      upStartTime : LReal;
      upEndTime : LReal;
      accRatio { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : LInt := 2;
   END_VAR

   VAR_OUTPUT 
      done : Bool;
      busy : Bool;
      error : Bool;
      errorID : Word;
   END_VAR

   VAR_IN_OUT 
      cam : DB_ANY;
      EmptyPoint {InstructionName := 'TO_Cam_Struct_PointData'; LibVersion := '9.0'} : Array[1..10000] of TO_Cam_Struct_PointData;
      EmptySegment {InstructionName := 'TO_Cam_Struct_SegmentData'; LibVersion := '9.0'} : Array[1..50] of TO_Cam_Struct_SegmentData;
   END_VAR

   VAR 
      instMCInterpolateCam {InstructionName := 'MC_INTERPOLATECAM'; LibVersion := '9.0'; S7_SetPoint := 'False'} : MC_INTERPOLATECAM;
      instMCCopyCamData {InstructionName := 'MC_COPYCAMDATA'; LibVersion := '9.0'} : MC_COPYCAMDATA;
      statBusy : Bool;
      statDone : Bool;
      statCalculateCamState { S7_SetPoint := 'True'} : DInt;
      statTimeTable : Array[1..50] of Time;
      statStartTime : Time;
      statEndTime : Time;
      CalCulateTrigger {InstructionName := 'R_TRIG'; LibVersion := '1.0'; S7_SetPoint := 'False'} : R_TRIG;
   END_VAR

   VAR_TEMP 
      tempCam {InstructionName := 'TO_Cam_10k'; LibVersion := '9.0'} : REF_TO TO_Cam_10k;
      tempFCount : DInt;
      tempFullTime : LReal;
      tempCycleTime : LReal;
      tempStartTime : LReal;
      tempRestTime : LReal;
      tempTime : Array[1..50] of LReal;
      tempPos : Array[1..50] of LReal;
      tempVel : Array[1..50] of LReal;
      tempAcc : Array[1..50] of LReal;
      tempJerk : Array[1..50] of LReal;
      tempX : Array[1..50] of LReal;
      tempCalAcc : Array[1..50] of LReal;
      tempCalVel : Array[1..50] of LReal;
      tempCalPos : Array[1..50] of LReal;
      tempA3 : Array[1..50] of LReal;
      tempA2 : Array[1..50] of LReal;
      tempA1 : Array[1..50] of LReal;
      tempA0 : Array[1..50] of LReal;
   END_VAR

   VAR CONSTANT 
      PI : LReal := 3.14159265358979;
      CC_IDLE : DInt;
      CC_INITIALIZE1 : DInt := 1;
      CC_INITIALIZE2 : DInt := 2;
      CC_INITIALIZE3 : DInt := 3;
      CC_CALCULATE : DInt := 4;
      CC_INTERPOLATE : DInt := 5;
      CC_DONE : DInt := 6;
      CC_ERROR : DInt := 99;
   END_VAR


BEGIN
	REGION Mapping Cam
	    #tempCam ?= #cam;
	END_REGION
	
	REGION Error Check
	    REGION MC_INTERPOLATE
	        IF #instMCInterpolateCam.Error
	        THEN
	            #statCalculateCamState := #CC_ERROR;
	            #errorID := #instMCInterpolateCam.ErrorId;
	        END_IF;
	    END_REGION
	    
	    REGION ACC RATIO
	        IF #accRatio < 2
	        THEN
	            #statCalculateCamState := #CC_ERROR;
	            #errorID := 16#1000;
	        END_IF;
	    END_REGION
	    
	    REGION BIT PARAMETER
	        IF NOT #ratioOption AND NOT #timeOption THEN
	            #statCalculateCamState := #CC_ERROR;
	            #errorID := 16#1001;
	        END_IF;
	    END_REGION
	    
	    REGION RATIO PARAMETER CHECK
	        IF #ratioOption THEN
	            IF #downStartRatio < 0.0
	                OR #downEndRatio < 0.0
	                OR #upStartRatio < 0.0
	                OR #upEndRatio < 0.0
	                OR #downStartRatio > 100.0
	                OR #downEndRatio > 100.0
	                OR #upStartRatio > 100.0
	                OR #upEndRatio > 100.0
	                OR #downEndRatio - #downStartRatio >= 50.0
	                OR #upEndRatio - #upStartRatio >= 50.0
	                OR #downStartRatio > #downEndRatio
	                OR #downEndRatio > #upStartRatio
	                OR #upStartRatio > #upEndRatio
	            THEN
	                #statCalculateCamState := #CC_ERROR;
	                #errorID := 16#1002;
	            END_IF;
	        END_IF;
	    END_REGION
	    
	    REGION TIME PARAMETER CHECK
	        IF #timeOption THEN
	            #tempFullTime := 60000.0 / #cpm;
	            IF #downStartTime < 0.0
	                OR #downEndTime < 0.0
	                OR #upStartTime < 0.0
	                OR #upEndTime < 0.0
	                OR #downStartTime > 100.0
	                OR #downEndTime > 100.0
	                OR #upStartTime > 100.0
	                OR #upEndTime > 100.0
	                OR #downEndTime - #downStartTime >= #tempFullTime / 2.0
	                OR #upEndTime - #upStartTime >= #tempFullTime / 2.0
	                OR #downStartTime > #downEndTime
	                OR #downEndTime > #upStartTime
	                OR #upStartTime > #upEndTime
	            THEN
	                #statCalculateCamState := #CC_ERROR;
	                #errorID := 16#1003;
	            END_IF;
	        END_IF;
	    END_REGION
	    
	    REGION BASIC PARAMETER CHECK
	        IF #cpm <= 0.0
	            OR #lineSpeed <= 0.0
	            OR ABS_LREAL(#distance1) = 0.0
	            OR ABS_LREAL(#distance2) = 0.0
	        THEN
	            #statCalculateCamState := #CC_ERROR;
	            #errorID := 16#1004;
	        END_IF;
	    END_REGION
	END_REGION
	
	REGION Execute
	    IF NOT #execute
	    THEN
	        #statCalculateCamState := #CC_IDLE;
	    END_IF;
	    IF #statCalculateCamState <> #CC_ERROR
	    THEN
	        #CalCulateTrigger(CLK := #execute);
	    END_IF;
	    IF #CalCulateTrigger.Q THEN
	        #instMCCopyCamData.NumberOfPoints := 10000;
	        #instMCCopyCamData.NumberOfSegments := 50;
	        #statStartTime := TIME_TCK();
	        #statCalculateCamState := #CC_INITIALIZE1;
	    END_IF;
	END_REGION
	
	REGION State Machine
	    CASE #statCalculateCamState OF
	        #CC_IDLE:
	            REGION READY
	                ;
	            END_REGION
	            
	        #CC_INITIALIZE1:
	            REGION INITIALIZE1
	                #tempFCount := 0;
	                FOR #tempFCount := 1 TO 10000 DO
	                    #tempCam^.Point[#tempFCount].x := 0.0;
	                    #tempCam^.Point[#tempFCount].y := 0.0;
	                    #tempCam^.ValidPoint[#tempFCount] := FALSE;
	                END_FOR;
	                
	                #tempFCount := 0;
	                FOR #tempFCount := 1 TO 50 DO
	                    #tempCam^.Segment[#tempFCount].a0 := 0.0;
	                    #tempCam^.Segment[#tempFCount].a1 := 0.0;
	                    #tempCam^.Segment[#tempFCount].a2 := 0.0;
	                    #tempCam^.Segment[#tempFCount].a3 := 0.0;
	                    #tempCam^.Segment[#tempFCount].a4 := 0.0;
	                    #tempCam^.Segment[#tempFCount].a5 := 0.0;
	                    #tempCam^.Segment[#tempFCount].a6 := 0.0;
	                    #tempCam^.Segment[#tempFCount].sineAmplitude := 0.0;
	                    #tempCam^.Segment[#tempFCount].sinePeriod := 0.0;
	                    #tempCam^.Segment[#tempFCount].sinePhase := 0.0;
	                    #tempCam^.Segment[#tempFCount].xmax := 0.0;
	                    #tempCam^.Segment[#tempFCount].xmin := 0.0;
	                    #tempCam^.ValidSegment[#tempFCount] := FALSE;
	                END_FOR;
	                
	                
	                #statCalculateCamState := #CC_CALCULATE;
	                
	            END_REGION
	            
	        #CC_CALCULATE:
	            REGION CALCULATE
	                #tempCycleTime := 60000.0 / #cpm;
	                IF #ratioOption THEN
	                    REGION RATIO
	                        #tempTime[1] := 0.0;
	                        #tempTime[2] := #lineSpeed * #tempCycleTime * #downStartRatio / 100.0 / 1000.0;
	                        #tempTime[3] := #lineSpeed * #tempCycleTime * (#downEndRatio - #downStartRatio) / 100.0 / 1000.0;
	                        #tempTime[4] := #lineSpeed * #tempCycleTime * (#upStartRatio - #downEndRatio) / 100.0 / 1000.0;
	                        #tempTime[5] := #lineSpeed * #tempCycleTime * (#upEndRatio - #upStartRatio) / 100.0 / 1000.0;
	                        #tempTime[6] := #lineSpeed * #tempCycleTime * (100.0 - #upEndRatio) / 100.0 / 1000.0;
	                        #tempTime[7] := #lineSpeed * #tempCycleTime * #downStartRatio / 100.0 / 1000.0;
	                        #tempTime[8] := #lineSpeed * #tempCycleTime * (#downEndRatio - #downStartRatio) / 100.0 / 1000.0;
	                        #tempTime[9] := #lineSpeed * #tempCycleTime * (#upStartRatio - #downEndRatio) / 100.0 / 1000.0;
	                        #tempTime[10] := #lineSpeed * #tempCycleTime * (#upEndRatio - #upStartRatio) / 100.0 / 1000.0;
	                        #tempTime[11] := #lineSpeed * #tempCycleTime * (100.0 - #upEndRatio) / 100.0 / 1000.0;
	                    END_REGION
	                ELSE
	                    REGION TIME
	                        IF #timeOption THEN
	                            #tempTime[1] := 0.0;
	                            #tempTime[2] := #downStartTime / 1000.0;
	                            #tempTime[3] := (#downEndTime - #downStartTime) / 1000.0;
	                            #tempTime[4] := (#upStartTime - #downEndTime) / 1000.0;
	                            #tempTime[5] := (#upEndTime - #upStartTime) / 1000.0;
	                            #tempTime[6] := (#tempCycleTime - #upEndTime) / 1000.0;
	                            #tempTime[7] := #downStartTime / 1000.0;
	                            #tempTime[8] := (#downEndTime - #downStartTime) / 1000.0;
	                            #tempTime[9] := (#upStartTime - #downEndTime) / 1000.0;
	                            #tempTime[10] := (#upEndTime - #upStartTime) / 1000.0;
	                            #tempTime[11] := (#tempCycleTime - #upEndTime) / 1000.0;
	                        END_IF;
	                    END_REGION
	                END_IF;
	                REGION DIVIDE
	                    // Calculate Time
	                    #tempTime[1] := 0.0;
	                    #tempTime[2] := #lineSpeed * #tempCycleTime * #downStartRatio / 100.0 / 1000.0;
	                    #tempTime[3] := #lineSpeed * #tempCycleTime * (#downEndRatio - #downStartRatio) / 100.0 / 1000.0;
	                    #tempTime[4] := #lineSpeed * #tempCycleTime * (#upStartRatio - #downEndRatio) / 100.0 / 1000.0;
	                    #tempTime[5] := #lineSpeed * #tempCycleTime * (#upEndRatio - #upStartRatio) / 100.0 / 1000.0;
	                    #tempTime[6] := #lineSpeed * #tempCycleTime * (100.0 - #upEndRatio) / 100.0 / 1000.0;
	                    #tempTime[7] := #lineSpeed * #tempCycleTime * #downStartRatio / 100.0 / 1000.0;
	                    #tempTime[8] := #lineSpeed * #tempCycleTime * (#downEndRatio - #downStartRatio) / 100.0 / 1000.0;
	                    #tempTime[9] := #lineSpeed * #tempCycleTime * (#upStartRatio - #downEndRatio) / 100.0 / 1000.0;
	                    #tempTime[10] := #lineSpeed * #tempCycleTime * (#upEndRatio - #upStartRatio) / 100.0 / 1000.0;
	                    #tempTime[11] := #lineSpeed * #tempCycleTime * (100.0 - #upEndRatio) / 100.0 / 1000.0;
	                    
	                    // Calculate Pos
	                    #tempPos[1] := 0.0;
	                    #tempPos[2] := 0.0;
	                    #tempPos[3] := #distance1;
	                    #tempPos[4] := 0.0;
	                    #tempPos[5] := - #distance1;
	                    #tempPos[6] := 0.0;
	                    #tempPos[7] := 0.0;
	                    #tempPos[8] := #distance2;
	                    #tempPos[9] := 0.0;
	                    #tempPos[10] := - #distance2;
	                    #tempPos[11] := 0.0;
	                    
	                    // Calculate Vel
	                    #tempVel[1] := 0.0;
	                    #tempVel[2] := 0.0;
	                    #tempVel[3] := 2.0 * #tempPos[3] / (#tempTime[3] * (2.0 - 2.0 / LINT_TO_LREAL(#accRatio)));
	                    #tempVel[4] := 0.0;
	                    #tempVel[5] := 2.0 * #tempPos[5] / (#tempTime[5] * (2.0 - 2.0 / LINT_TO_LREAL(#accRatio)));
	                    #tempVel[6] := 0.0;
	                    #tempVel[7] := 0.0;
	                    #tempVel[8] := 2.0 * #tempPos[8] / (#tempTime[8] * (2.0 - 2.0 / LINT_TO_LREAL(#accRatio)));
	                    #tempVel[9] := 0.0;
	                    #tempVel[10] := 2.0 * #tempPos[10] / (#tempTime[10] * (2.0 - 2.0 / LINT_TO_LREAL(#accRatio)));
	                    #tempVel[11] := 0.0;
	                    
	                    // Calculate Acc
	                    #tempAcc[1] := 0.0;
	                    #tempAcc[2] := 0.0;
	                    #tempAcc[3] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempVel[3] / #tempTime[3];
	                    #tempAcc[4] := 0.0;
	                    #tempAcc[5] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempVel[5] / #tempTime[5];
	                    #tempAcc[6] := 0.0;
	                    #tempAcc[7] := 0.0;
	                    #tempAcc[8] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempVel[8] / #tempTime[8];
	                    #tempAcc[9] := 0.0;
	                    #tempAcc[10] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempVel[10] / #tempTime[10];
	                    #tempAcc[11] := 0.0;
	                    
	                    // Calculate Jerk
	                    #tempJerk[1] := 0.0;
	                    #tempJerk[2] := 0.0;
	                    #tempJerk[3] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[3] / #tempTime[3];
	                    #tempJerk[4] := - LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[3] / #tempTime[3];
	                    #tempJerk[5] := 0.0;
	                    #tempJerk[6] := - LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[3] / #tempTime[3];
	                    #tempJerk[7] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[3] / #tempTime[3];
	                    #tempJerk[8] := 0.0;
	                    #tempJerk[9] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[5] / #tempTime[5];
	                    #tempJerk[10] := - LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[5] / #tempTime[5];
	                    #tempJerk[11] := 0.0;
	                    #tempJerk[12] := - LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[5] / #tempTime[5];
	                    #tempJerk[13] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[5] / #tempTime[5];
	                    #tempJerk[14] := 0.0;
	                    #tempJerk[15] := 0.0;
	                    #tempJerk[16] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[8] / #tempTime[8];
	                    #tempJerk[17] := - LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[8] / #tempTime[8];
	                    #tempJerk[18] := 0.0;
	                    #tempJerk[19] := - LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[8] / #tempTime[8];
	                    #tempJerk[20] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[8] / #tempTime[8];
	                    #tempJerk[21] := 0.0;
	                    #tempJerk[22] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[10] / #tempTime[10];
	                    #tempJerk[23] := - LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[10] / #tempTime[10];
	                    #tempJerk[24] := 0.0;
	                    #tempJerk[25] := - LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[10] / #tempTime[10];
	                    #tempJerk[26] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[10] / #tempTime[10];
	                    #tempJerk[27] := 0.0;
	                    
	                    // Calculate X
	                    #tempX[1] := #tempTime[1];
	                    #tempX[2] := #tempTime[2];
	                    #tempX[3] := #tempTime[3] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[4] := #tempTime[3] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[5] := #tempTime[3] * (1.0 - 2.0 / LINT_TO_LREAL(#accRatio));
	                    #tempX[6] := #tempTime[3] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[7] := #tempTime[3] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[8] := #tempTime[4];
	                    #tempX[9] := #tempTime[5] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[10] := #tempTime[5] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[11] := #tempTime[5] * (1.0 - 2.0 / LINT_TO_LREAL(#accRatio));
	                    #tempX[12] := #tempTime[5] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[13] := #tempTime[5] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[14] := #tempTime[6];
	                    #tempX[15] := #tempTime[7];
	                    #tempX[16] := #tempTime[8] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[17] := #tempTime[8] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[18] := #tempTime[8] * (1.0 - 2.0 / LINT_TO_LREAL(#accRatio));
	                    #tempX[19] := #tempTime[8] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[20] := #tempTime[8] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[21] := #tempTime[9];
	                    #tempX[22] := #tempTime[10] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[23] := #tempTime[10] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[24] := #tempTime[10] * (1.0 - 2.0 / LINT_TO_LREAL(#accRatio));
	                    #tempX[25] := #tempTime[10] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[26] := #tempTime[10] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                    #tempX[27] := #tempTime[11];
	                    
	                    
	                    // ==============================================================================
	                    // Segment [1]
	                    // ==============================================================================                           
	                    #tempCalAcc[1] := 0.0;
	                    #tempCalVel[1] := 0.0;
	                    #tempCalPos[1] := 0.0;
	                    #tempA3[1] := #tempJerk[1] / 6.0;
	                    #tempA2[1] := #tempCalAcc[1] / 2.0;
	                    #tempA1[1] := #tempCalVel[1];
	                    #tempA0[1] := #tempCalPos[1];
	                    #tempCam^.Segment[1].a4 := 0.0;
	                    #tempCam^.Segment[1].a5 := 0.0;
	                    #tempCam^.Segment[1].a6 := 0.0;
	                    #tempCam^.Segment[1].xmax := #tempX[1];
	                    #tempCam^.Segment[1].xmin := 0.0;
	                    #tempCam^.Segment[1].sineAmplitude := 0.0;
	                    #tempCam^.Segment[1].sinePeriod := 0.0;
	                    #tempCam^.Segment[1].sinePhase := 0.0;
	                    IF #tempX[1] = 0.0 THEN
	                        #tempCam^.ValidSegment[1] := FALSE;
	                    ELSE
	                        #tempCam^.ValidSegment[1] := TRUE;
	                    END_IF;
	                    
	                    // ==============================================================================
	                    // Segment [2]
	                    // ============================================================================== 
	                    #tempCalAcc[2] := #tempJerk[2 - 1] * #tempX[2 - 1] + #tempCalAcc[2 - 1];
	                    #tempCalVel[2] := #tempJerk[2 - 1] * #tempX[2 - 1] * #tempX[2 - 1] / 2.0 + #tempCalAcc[2 - 1] * #tempX[2 - 1] + #tempCalVel[2 - 1];
	                    #tempCalPos[2] := #tempJerk[2 - 1] * #tempX[2 - 1] * #tempX[2 - 1] * #tempX[2 - 1] / 6.0 + #tempCalAcc[2 - 1] * #tempX[2 - 1] * #tempX[2 - 1] / 2.0 + #tempCalVel[2 - 1] * #tempX[2 - 1] + #tempCalPos[2 - 1];
	                    IF ABS_LREAL(#tempCalVel[2]) < 0.000000001 THEN
	                        #tempCalVel[2] := 0.0;
	                    END_IF;
	                    IF ABS_LREAL(#tempCalPos[2]) < 0.000000001 THEN
	                        #tempCalPos[2] := 0.0;
	                    END_IF;
	                    #tempA3[2] := #tempJerk[2] / 6.0;
	                    #tempA2[2] := #tempCalAcc[2] / 2.0;
	                    #tempA1[2] := #tempCalVel[2];
	                    #tempA0[2] := #tempCalPos[2];
	                    #tempCam^.Segment[2].a0 := #tempA0[2];
	                    #tempCam^.Segment[2].a1 := #tempA1[2];
	                    #tempCam^.Segment[2].a2 := #tempA2[2];
	                    #tempCam^.Segment[2].a3 := #tempA3[2];
	                    #tempCam^.Segment[2].a4 := 0.0;
	                    #tempCam^.Segment[2].a5 := 0.0;
	                    #tempCam^.Segment[2].a6 := 0.0;
	                    #tempCam^.Segment[2].xmax := #tempCam^.Segment[2 - 1].xmax + #tempX[2];
	                    #tempCam^.Segment[2].xmin := #tempCam^.Segment[2 - 1].xmax;
	                    #tempCam^.Segment[2].sineAmplitude := 0.0;
	                    #tempCam^.Segment[2].sinePeriod := 0.0;
	                    #tempCam^.Segment[2].sinePhase := 0.0;
	                    IF #tempX[2] = 0.0 THEN
	                        #tempCam^.ValidSegment[2] := FALSE;
	                    ELSE
	                        #tempCam^.ValidSegment[2] := TRUE;
	                    END_IF;
	                    
	                    // ==============================================================================
	                    // Segment [3]
	                    // ==============================================================================                     
	                    #tempCalAcc[3] := #tempJerk[3 - 1] * #tempX[3 - 1] + #tempCalAcc[3 - 1];
	                    #tempCalVel[3] := #tempJerk[3 - 1] * #tempX[3 - 1] * #tempX[3 - 1] / 2.0 + #tempCalAcc[3 - 1] * #tempX[3 - 1] + #tempCalVel[3 - 1];
	                    #tempCalPos[3] := #tempJerk[3 - 1] * #tempX[3 - 1] * #tempX[3 - 1] * #tempX[3 - 1] / 6.0 + #tempCalAcc[3 - 1] * #tempX[3 - 1] * #tempX[3 - 1] / 2.0 + #tempCalVel[3 - 1] * #tempX[3 - 1] + #tempCalPos[3 - 1];
	                    IF ABS_LREAL(#tempCalVel[3]) < 0.000000001 THEN
	                        #tempCalVel[3] := 0.0;
	                    END_IF;
	                    IF ABS_LREAL(#tempCalPos[3]) < 0.000000001 THEN
	                        #tempCalPos[3] := 0.0;
	                    END_IF;
	                    #tempA3[3] := #tempJerk[3] / 6.0;
	                    #tempA2[3] := #tempCalAcc[3] / 2.0;
	                    #tempA1[3] := #tempCalVel[3];
	                    #tempA0[3] := #tempCalPos[3];
	                    #tempCam^.Segment[3].a0 := #tempA0[3];
	                    #tempCam^.Segment[3].a1 := #tempA1[3];
	                    #tempCam^.Segment[3].a2 := #tempA2[3];
	                    #tempCam^.Segment[3].a3 := #tempA3[3];
	                    #tempCam^.Segment[3].a4 := 0.0;
	                    #tempCam^.Segment[3].a5 := 0.0;
	                    #tempCam^.Segment[3].a6 := 0.0;
	                    #tempCam^.Segment[3].xmax := #tempCam^.Segment[3 - 1].xmax + #tempX[3];
