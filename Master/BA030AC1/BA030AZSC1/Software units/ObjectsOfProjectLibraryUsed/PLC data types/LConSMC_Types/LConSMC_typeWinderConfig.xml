<?xml version="1.0" encoding="utf-8"?>
<Document>
  <Engineering version="V20" />
  <SW.Types.PlcStruct ID="0">
    <AttributeList>
      <Access>Published</Access>
      <Interface><Sections xmlns="http://www.siemens.com/automation/Openness/SW/Interface/v5">
  <Section Name="None">
    <Member Name="positionControlled" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Enable MoveVelocity position controlled in case of positioning axis</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Enable MoveVelocity position controlled in case of positioning axis</MultiLanguageText>
      </Comment>
      <StartValue>FALSE</StartValue>
    </Member>
    <Member Name="axisCtrl" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">FALSE: Setpoints (Velocity, Torque) are not forwarded to the axis. An external axis control must be realized (see diagnostic outputs "referenceVelocity" and "diameterFactor")  TRUE: Setpoints (Velocity, Torque) are forwarded to the axis internally</MultiLanguageText>
        <MultiLanguageText Lang="en-US">FALSE: Setpoints (Velocity, Torque) are not forwarded to the axis. An external axis control must be realized (see diagnostic outputs "referenceVelocity" and "diameterFactor")  TRUE: Setpoints (Velocity, Torque) are forwarded to the axis internally</MultiLanguageText>
      </Comment>
      <StartValue>TRUE</StartValue>
    </Member>
    <Member Name="jogVelocity" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m/min oder ft/min] Web velocity to jog the drive via the inputs "jogPos" and "jogNeg"</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m/min oder ft/min] Web velocity to jog the drive via the inputs "jogPos" and "jogNeg"</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="overrideVelocity" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m/min or ft/min] Additive velocity offset for speed controller  This value is only needed for the torque controlled modes (controlMode = 1-3)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m/min or ft/min] Additive velocity offset for speed controller  This value is only needed for the torque controlled modes (controlMode = 1-3)</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="maxVelocity" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m/min or ft/min] Maximum possible web velocity. Maximum speed setpoint of the axis is limited to maxVelocity (+ overrideVelocity) and minimum diameter</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m/min or ft/min] Maximum possible web velocity. Maximum speed setpoint of the axis is limited to maxVelocity (+ overrideVelocity) and minimum diameter</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="getAxisConfigAtStart" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Readout gear,reference torque and units from axis with rising edge. FALSE: Take config values</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Readout gear,reference torque and units from axis with rising edge. FALSE: Take config values</MultiLanguageText>
      </Comment>
      <StartValue>TRUE</StartValue>
    </Member>
    <Member Name="noOfSamplesLineVelocity" Datatype="UInt">
      <Comment>
        <MultiLanguageText Lang="de-DE">Number of samples for moving average filter of line velocity setpoint for synchronizing to a moving web</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Number of samples for moving average filter of line velocity setpoint for synchronizing to a moving web</MultiLanguageText>
      </Comment>
      <StartValue>1</StartValue>
    </Member>
    <Member Name="unitConfiguration" Datatype="&quot;LConSMC_typeUnitConfiguration&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">Configuration of the units</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Configuration of the units</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="winderDynamics" Datatype="&quot;LConSMC_typeAxisDynamics&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">Configuration of the axis dynamics</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Configuration of the axis dynamics</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="torquePrecontrolConfig" Datatype="&quot;LConSMC_typeTorquePrecontrolConfig&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">Configuration parameters for torque precontrol</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Configuration parameters for torque precontrol</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="diamConfig" Datatype="&quot;LConSMC_typeDiamConfig&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">Configuration parameters for diameter calculation</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Configuration parameters for diameter calculation</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="technologyControllerConfig" Datatype="&quot;LConSMC_typeTechnologyControllerConfig&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">Configuration parameters for technology controller (Dancer or load cell)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Configuration parameters for technology controller (Dancer or load cell)</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="webbreakDetectionConfig" Datatype="&quot;LConSMC_typeWebbreakDetectConfig&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">Configuration parameters for webbreak detection</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Configuration parameters for webbreak detection</MultiLanguageText>
      </Comment>
    </Member>
  </Section>
</Sections></Interface>
