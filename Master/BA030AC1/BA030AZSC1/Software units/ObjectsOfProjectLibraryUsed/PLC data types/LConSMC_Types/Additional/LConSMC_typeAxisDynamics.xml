  <Section Name="None">
    <Member Name="stopDynamics" Datatype="&quot;LConSMC_typeStopDynamics&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">[Einheit der Achse] Dynamiken zum Stoppen der Achse  Wirksam wenn "enable" = FALSE oder wenn "speedMatch" = FALSE bei laufender Bahn</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[Unit of the axis] Dynamics for stopping the axis  Active if "enable" = FALSE or "speedMatch" = FLASE and running web</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="syncDynamics" Datatype="&quot;LConSMC_typeSyncDynamics&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">[Einheit der Achse] Dynamiken zum synchronisieren auf eine laufende Bahn  Wirksam wenn "enable" &amp; "speedMatch" = TRUE</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[Unit of the axis] Dynamics for synchronizing to line speed  Active if "enable" &amp; "speedMatch" = TRUE</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="operationDynamics" Datatype="&quot;LConSMC_typeOperationDynamics&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">[Einheit der Achse] Dynamiken die im Normalbetrieb wirken (müssen größer oder gleich denen des Leitwertes sein!!)  Wirksam wenn "enable" &amp; "speedMatch" &amp; "ctrlEnable" = TRUE</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[Unit of the axis] Dynamics during normal operation  Active if "enable" &amp; "speedMatch" &amp; "ctrlEnable" = TRUE</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="jogDynamics" Datatype="&quot;LConSMC_typeJogDynamics&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">[Einheit der Achse] Dynamiken zum Tippen der Achse  Wirken wenn "JogPos" oder "jogNeg" = TRUE</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[Unit of the axis] Dynamics for jogging the axis  Active if "JogPos" or "jogNeg" = TRUE</MultiLanguageText>
      </Comment>
    </Member>
  </Section>
</Sections></Interface>
