<?xml version="1.0" encoding="utf-8"?>
<Document>
  <Engineering version="V20" />
  <SW.Types.PlcStruct ID="0">
    <AttributeList>
      <Access>Published</Access>
      <Interface><Sections xmlns="http://www.siemens.com/automation/Openness/SW/Interface/v5">
  <Section Name="None">
    <Member Name="minLineVelocity" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m/min oder ft/min] Minimale Bahngeschwindigkeit dass der Durchmesserrechner aktiviert wird</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m/min or ft/min] Minimum web speed to activate the diametet calculation</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="minShaftSpeed" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">[min-1] Minimale Drehzahl der Wickelwelle dass der Durchmesserrechner aktiviet wird</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[min-1] Minimum winder shaft speed to activate diameter calculation</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="minDia" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m oder inch] Minimaler Durchmesserwert</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m or inch] Minimum diameter value</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="maxDia" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m oder inch] Maximaler Durchmesserwert</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m or inch] Maximum diameter value</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="webThickness" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m oder inch] Materialdicke  WIrd für die Berechnungsarten 1&amp;4 benötigt</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m or inch] Web thickness  Necessary for the calculation modes 1&amp;4</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="useLineAxisActualValues" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Verwende die Istwerte der Bahn zur Durchmesserberechnung. Eingang "lineAxisActualValues" am Wickler  FALSE: Verwende die Sollwerte am Eingang "lineAxisMotionVector"</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Use line actual values (s,v) for the diameter calculation from winder input "lineAxisActualValues"  FALSE: Use values from the winder input "lineAxisMotionVector"</MultiLanguageText>
      </Comment>
      <StartValue>TRUE</StartValue>
    </Member>
    <Member Name="diameterSetValue" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m oder inch] Setzwert für den Durchmesser wenn Eingang "setDiameter" am Wicklereingang = TRUE</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m or inch] Diameter set value (If winder input "setDiameter" = TRUE)</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="lineFilterTime" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">[ms] PT1 Filterzeit für Bahngeschwindigkeit</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[ms] PT1 filter time for line velocity </MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="shaftFilterTime" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">[ms] PT1 Filterzeit für Wicklerdrehzahl</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[ms] PT1 filter time for winder speed </MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="measuringRevolutionCount" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">Anzahl an Umdrehungen die für die Mittelung des Durchmessers verwenet werden  Nur relevant in den Modi Integral (2) und Position (5)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Number of shaft revolutions used for averaging the diameter  Only relevant for calculation modes integral (2) and position (5)</MultiLanguageText>
      </Comment>
      <StartValue>4.0</StartValue>
    </Member>
    <Member Name="firstDiameterOutput" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">Anzahl an Umdrehungen nachdem der erste berechnete Durchmesserwert ausgegeben wird  Nur relevant in den Modi Integral (2) und Position (5)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Number of shaft revolutions after which the first diameter value is calculated  Only relevant for calculation modes integral (2) and position (5)</MultiLanguageText>
      </Comment>
      <StartValue>0.5</StartValue>
    </Member>
    <Member Name="diameterOutputRate" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">Anzahl an Umdrehungen nach dem ersten Durchmesserwert nachdem neue berechnete Durchmesserwerte ausgegeben werden  Nur relevant in den Modi Integral (2) und Position (5)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Number of shaft revolutions after the first diameter after which a new diameter value is calculated  Only relevant for calculation modes integral (2) and position (5)</MultiLanguageText>
      </Comment>
      <StartValue>1.0</StartValue>
    </Member>
    <Member Name="lineModLength" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">Modulolänge der Bahnachse. 0 = Keine Moduloachse  Nur relevant im Mode Position (5)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Modulo length of the line axis. 0 = No modulo axis  Only relevant for calculation mode position (5)</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="shaftModLength" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">Modulolänge der Wicklerachse. 0 = Keine Moduloachse  Nur relevant im Mode Position (5)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Modulo length of the winder axis. 0 = No modulo axis  Only relevant for calculation mode position (5)</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="diameterFilterTime" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">[ms] PT1 Filterzeit für Durchmesserausgang</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[ms] PT1 filter time for diameter output value</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
  </Section>
</Sections></Interface>
