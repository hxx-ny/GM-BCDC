  <Section Name="None">
    <Member Name="enableDetection" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Freigabe der Bahnrissüberwachung</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Enable webbreak detection</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="minLineVelocity" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m/min or ft/min] Minimale Bahngeschwindigkeit ab der die Überwachung aktiviert wird</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m/min or ft/min] Minimum line speed for detection to be active</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="upperLimitError" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">[Einheit des Zug-/Tänzeristwertes] Oberere Grenzwert bei dem ein Bahnriss erkannt wird  !Im Regelungmodus "Indirekte Zugregelung" wird die Soll-/Istdrehmomentabweichung bezogen auf das Referenzdrehmoment in Prozent überwacht!</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[Unit of tension/dancer feedback] Upper limit for detecting web break  !In the control mode "Indirect tension control" the torque deviation in relation to the reference torque in precent is monitored!</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="lowerLimitError" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">[Einheit des Zug-/Tänzeristwertes] Unterer Grenzwert bei dem ein Bahnriss erkannt wird  !Im Regelungmodus "Indirekte Zugregelung" wird die Soll-/Istdrehmomentabweichung bezogen auf das Referenzdrehmoment in Prozent überwacht!</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[Unit of tension/dancer feedback] Lower limit for detecting web break  !In the control mode "Indirect tension control" the torque deviation in relation to the reference torque in precent is monitored!</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="delayTime" Datatype="Time">
      <Comment>
        <MultiLanguageText Lang="de-DE">Verzögerungszeit nachdem der Diagoseausgang "webBreak" = TRUE gesetzt wird</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Delay time before diagnostic output "webBreak" is set to TRUE</MultiLanguageText>
      </Comment>
    </Member>
  </Section>
</Sections></Interface>
