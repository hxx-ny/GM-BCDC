FUNCTION_BLOCK "GetIdentMv"
{ S7_Optimized_Access := 'TRUE' ; Published := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      identMvAllUnits { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0.."NO_OF_UNITS"] of "typeEMIdentMv";   // HMI: motorstarter values
      numberOfMvReaders : USInt;
   END_VAR

   VAR_OUTPUT 
      selectedUnit : USInt;
      selectedEM : USInt;
      error : Word;
   END_VAR

   VAR_IN_OUT 
      IdentMvInterfaceHmi : "typeIdentMvHmi";
   END_VAR

   VAR 
      statSelectedEMIdentMv : USInt := 1;
      statSelectedUnitIdentRMv : USInt := 1;   // HMI: Selected unit
   END_VAR

   VAR_TEMP 
      tempEnable : Bool;   // Temporary value for input 'enable'
      tempMvReader : Array[0.."NO_OF_MV_IDENT_DEVICES"] of "LSicar_typeIdentInterfaceHmi";
      tempIndexIdentMv : USInt;
      tempNoOfidertMv : USInt;
   END_VAR

   VAR CONSTANT 
      "INVALID UNIT" : Word := 16#7001;   // non existant unit
      "INVALID EM" : Word := 16#7002;   // non existant em
      OK : Word := 16#7000;
   END_VAR


BEGIN
	REGION BLOCK INFO HEADER
	    //===============================================================================
	    // Siemens AG / (c)Copyright 2024
	    //-------------------------------------------------------------------------------
	    // Title:            LAF_GetMotorstarterSignals
	    // Comment/Function: This block reads diagnostic information of a Motorstarter depending
	    //                   on the unit and Control Module selected in the HMI by the user.
	    // Library/Family:   Automation Framework / Motorstarter Diagnostic
	    // Author:           Siemens Digital Industries
	    // Tested with:      S7-1517TF V3.1
	    // Engineering:      TIA Portal V19
	    // Restrictions:     
	    //                   Required UDTs: LAF_typeDriveDiagConfig, LAF_typeDriveDiagInterfaceHmi
	    // Requirements:     S7-1500(T), MC_Version V8.0
	    //-------------------------------------------------------------------------------
	    // Change log table:
	    // Version  | Date       | Expert in charge        | Changes applied
	    //----------|------------|-------------------------|-----------------------------
	    // 01.00.00 | 05.06.2024 | SIMATIC Systems Support | First released version
	    //===============================================================================
	END_REGION BLOCK INFO HEADER
	
	REGION DESCRIPTION
	(/*
	This block reads diagnostic information (control inputs and outputs) of a Motorstarter. 
	At runtime, this block is enabled when the ET200SP Motorstarter screen is shown in the HMI. 
	Based on the selected motorstarter object in the HMI by the user. The shown information in the HMI depends on the
	Unit and Cotrol Module selected. 
	*/)
	END_REGION DESCRIPTION
	
	REGION INPUTS
	    //working with static values to keep the last selected value when opening for the first time the screen  
	  
	    #statSelectedUnitIdentRMv := #IdentMvInterfaceHmi.selectedUnit;
	    #statSelectedEMIdentMv := #IdentMvInterfaceHmi.selectedEM;
	
	END_REGION INPUTS
	
	REGION ASSIGNING TEMPORARY VALUES
	    // Statement section REGION
	    IF #statSelectedUnitIdentRMv <= "NO_OF_UNITS" THEN
	        IF #statSelectedEMIdentMv < "NO_OF_EM" THEN
	            #tempMvReader := #identMvAllUnits[#statSelectedUnitIdentRMv].identMvEM[#statSelectedEMIdentMv].mvReader;
	            #tempNoOfidertMv := #numberOfMvReaders;
	            #error := #OK;
	        ELSE
	            #error := #"INVALID EM";
	        END_IF;
	
	    ELSE
	        #error := #"INVALID UNIT";
	    END_IF;
	
	
	END_REGION
	
	
	REGION OUTPUTS
	    // Statement section REGION
	    #IdentMvInterfaceHmi.mvReader := #tempMvReader;
	    #selectedEM := #statSelectedEMIdentMv;
	    #selectedUnit := #statSelectedUnitIdentRMv;
	END_REGION
	
	
END_FUNCTION_BLOCK

