  <NewLine UId="32" />
  <LineComment UId="33">
    <Text UId="34">  file name:      LDrvOpt_MovAverage (Motion Control Application Cycle)</Text>
  </LineComment>
  <NewLine UId="35" />
  <LineComment UId="36">
    <Text UId="37">  library:        LDrvOpt</Text>
