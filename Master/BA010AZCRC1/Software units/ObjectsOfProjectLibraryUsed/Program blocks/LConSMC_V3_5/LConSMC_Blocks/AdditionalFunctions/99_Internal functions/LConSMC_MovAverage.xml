  <NewLine UId="44" />
  <LineComment UId="45">
    <Text UId="46">  restrictions:   Must be called in PreIpo</Text>
  </LineComment>
  <NewLine UId="47" />
  <LineComment UId="48">
    <Text UId="49">  requirements:   /</Text>
  </LineComment>
  <NewLine UId="50" />
  <LineComment UId="51">
    <Text UId="52">  functionality:  This function block calculates the moving average for any input signal by an user defined </Text>
  </LineComment>
  <NewLine UId="53" />
  <LineComment UId="54">
    <Text UId="55">                  subset n. It also delivers the centered input signal for the moving average.</Text>
  </LineComment>
  <NewLine UId="56" />
  <LineComment UId="57">
    <Text UId="58">                  Any changes of the subset length during calculation causes no peak. It may be used to smooth</Text>
  </LineComment>
  <NewLine UId="59" />
  <LineComment UId="60">
    <Text UId="61">                  loop control signals.    </Text>
  </LineComment>
  <NewLine UId="62" />
  <LineComment UId="63">
    <Text UId="64">        </Text>
  </LineComment>
  <NewLine UId="65" />
  <LineComment UId="66">
    <Text UId="67">                  The implemented algorithm calculates as shown in the following formula:            </Text>
  </LineComment>
  <NewLine UId="68" />
  <LineComment UId="69">
    <Text UId="70">                  µ_(n)     =     (1 / n) * SUM[i = k-n...k] x_i</Text>
  </LineComment>
  <NewLine UId="71" />
