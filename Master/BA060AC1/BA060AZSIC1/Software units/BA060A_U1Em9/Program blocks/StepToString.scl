NAMESPACE Unit1.Em9
FUNCTION "StepToString" : String
{ S7_Optimized_Access := 'TRUE' ; Published := 'FALSE' }
VERSION : 0.1
   VAR_INPUT 
      StepDINT : DInt;   // DINT value of the step
      sequenceNumber : Int;
   END_VAR


BEGIN
	// Translates the sequence step number to the step name
	// This is an example and needs to be adjusted for the real use case
	
	IF #sequenceNumber = 1 THEN
	  CASE #StepDINT OF
	    1:
	      #StepToString := 'Idle';
	    101:
	      #StepToString := 'JOB[1] Condition';
	    110:
	      #StepToString := 'Light Up';
	    130:
	      #StepToString := 'Stage Lift Up';
	    140:
	      #StepToString := 'Hot Press Right JR Detection Check';
	    141:
	      #StepToString := 'Hot Press Right JR Detection Check Completed';
	    160:
	      #StepToString := 'Stage Lift Down';
	    190:
	      #StepToString := 'JOB[1] Step End';
	    201:
	      #StepToString := 'JOB[2] Condition';
	    210:
	      #StepToString := 'Vision Loading Request => Transfer PP Right';
	    230:
	      #StepToString := 'Stage Lift Up';
	    240:
	      #StepToString := 'Vision Loading Check => Transfer PP Right';
	    250:
	      #StepToString := 'Vision Check JR Detection Check';
	    290:
	      #StepToString := 'JOB[2] Step End';
	    301:
	      #StepToString := 'JOB[3] Condition';
	    310:
	      #StepToString := 'Stage Lift Down';
	    311:
	      #StepToString := 'Stage JR Detection Check';
	    320:
	      #StepToString := 'Light Down';
	    330:
	      #StepToString := 'Vision Start';
	    331:
	      #StepToString := 'Vision Result';
	    390:
	      #StepToString := 'JOB[3] Step End';
	    401:
	      #StepToString := 'JOB[4] Condition';
	    410:
	      #StepToString := 'Light Up';
	    420:
	      #StepToString := 'Stage Lift Up';
	    430:
	      #StepToString := 'Vision Unloading Request => Transfer PP Right';
	    431:
	      #StepToString := 'Vision Unloading Check => Transfer PP Right';
	    480:
	      #StepToString := 'Stage Lift Down';
	    490:
	      #StepToString := 'JOB[4] Step End';
	    9001:
	      #StepToString := 'Immediate Stop';
	      
	    ELSE
	      #StepToString := 'N/A';
	END_CASE;
	ELSE
	    #StepToString := 'N/A';
	END_IF;
END_FUNCTION
END_NAMESPACE

