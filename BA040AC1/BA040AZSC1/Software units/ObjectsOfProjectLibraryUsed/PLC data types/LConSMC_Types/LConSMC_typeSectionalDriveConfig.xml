<?xml version="1.0" encoding="utf-8"?>
<Document>
  <Engineering version="V20" />
  <SW.Types.PlcStruct ID="0">
    <AttributeList>
      <Access>Published</Access>
      <Interface><Sections xmlns="http://www.siemens.com/automation/Openness/SW/Interface/v5">
  <Section Name="None">
    <Member Name="positionControlled" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Achse wird lagegeregelt betrieben  FALSE: Achse wird Drehzahlgeregelt betrieben</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Enable MoveVelocity position controlled in case of positioning axis</MultiLanguageText>
      </Comment>
      <StartValue>FALSE</StartValue>
    </Member>
    <Member Name="axisCtrl" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Sollwerte werden an den Antrieb gesendet  FALSE: Es werden nur Sollwerte berechnet aber es erfolgt keine Kommunikation mit dem Antrieb</MultiLanguageText>
        <MultiLanguageText Lang="en-US">FALSE: No axis control just calculated setpoints TRUE: Use MoveVelocity to forward setpoints to axis</MultiLanguageText>
      </Comment>
      <StartValue>TRUE</StartValue>
    </Member>
    <Member Name="jogVelocity" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m/min oder ft/min] Bahngeschwindigkeit zum Vertippen der Achse über die Eingänge "jogPos" und "jogNeg"</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m/min oder ft/min] Web velocity to jog the drive via the inputs "jogPos" and "jogNeg"</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="diameter" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m oder inch] Durchmesser der Zugwalze</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m or inch] Diameter of sectional drive axis</MultiLanguageText>
      </Comment>
      <StartValue>1.0</StartValue>
    </Member>
    <Member Name="overrideVelocity" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m/min oder ft/min] Additive Zusatzgeschwindigkeit zur Übersteuerung des Drehzahlreglers. Dieser Wer wird in den drehmomentengeregelten Modi benötigt (controlMode = 1-3)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m/min or ft/min] Additive velocity offset for speed controller  This value is only needed for the torque controlled modes (controlMode = 1-3)</MultiLanguageText>
      </Comment>
      <StartValue>10.0</StartValue>
    </Member>
    <Member Name="maxVelocity" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m/min or ft/min] Maximum possible web velocity. Maximum speed setpoint of the axis is limited to maxVelocity (+ overrideVelocity) and minimum diameter</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m/min or ft/min] Maximum possible web velocity. Maximum speed setpoint of the axis is limited to maxVelocity (+ overrideVelocity) and minimum diameter</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="getAxisConfigAtStart" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Achskonfiguration (Getriebe, Referenzdrehmoment, Achseinheiten) wird mit steigender Flanke an "enable" ausgelesen  FALSE: Die Konfigurationsdaten müssen manuell in der Konfigurationsstruktur eingegeben werden</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Readout gear,reference torque and units from axis with rising edge. FALSE: Take config values</MultiLanguageText>
      </Comment>
      <StartValue>TRUE</StartValue>
    </Member>
    <Member Name="noOfSamplesLineVelocity" Datatype="UInt">
      <Comment>
        <MultiLanguageText Lang="de-DE">Anzahl an samples für die gleitende Mittelwertbildung des Bahnsollwertes während dem Aufsynchronisieren auf eine fahrende Bahn</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Number of samples for moving average filter of line velocity setpoint for synchronizing to a moving web</MultiLanguageText>
      </Comment>
      <StartValue>1</StartValue>
    </Member>
    <Member Name="unitConfiguration" Datatype="&quot;LConSMC_typeUnitConfiguration&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">Konfiguration der Einheiten</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Configuration of the units</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="SectionalDriveDynamics" Datatype="&quot;LConSMC_typeAxisDynamics&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">Konfiguration der Dynamiken</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Configuration of the axis dynamics</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="technologyControllerConfig" Datatype="&quot;LConSMC_typeTechnologyControllerConfig&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">Konfiguration des Technologiereglers (Tänzer oder Zugmessdose)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Configuration parameters for technology controller (Dancer or load cell)</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="torquePrecontrolConfig" Datatype="&quot;LConSMC_typeSectionalDriveTorquePrecontrolConfig&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">Konfiguration der Drehmomentenvorsteuerung</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Configuration parameters for torque precontrol</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="webbreakDetectionConfig" Datatype="&quot;LConSMC_typeWebbreakDetectConfig&quot;">
      <AttributeList>
        <BooleanAttribute Name="SetPoint" SystemDefined="true">true</BooleanAttribute>
      </AttributeList>
      <Comment>
        <MultiLanguageText Lang="de-DE">Konfiguration der Bahnrisserkennung</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Configuration parameters for webbreak detection</MultiLanguageText>
      </Comment>
    </Member>
  </Section>
</Sections></Interface>
