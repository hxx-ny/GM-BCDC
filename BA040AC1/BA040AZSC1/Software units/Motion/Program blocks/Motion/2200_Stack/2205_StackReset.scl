      instResetFinalRoller {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCompensator {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPX1 {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPX2 {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ1 {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ2 {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPX1 {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPX2 {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ1 {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ2 {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodeMandrelYFront {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodeMandrelYRear {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodeMandrelZFront {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodeMandrelZRear {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodeMandrelYFront {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodeMandrelYRear {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodeMandrelZFront {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodeMandrelZRear {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetFinalRollerCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCompensatorCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPX1Cam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPX2Cam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ1Cam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ2Cam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPX1Cam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPX2Cam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ1Cam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ2Cam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodeMandrelYFrontCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodeMandrelYRearCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodeMandrelZFrontCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodeMandrelZRearCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodeMandrelYFrontCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodeMandrelYRearCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodeMandrelZFrontCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodeMandrelZRearCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPX1FwdOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPX1BwdOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPX2FwdOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPX2BwdOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ1Down1OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ1Up1OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ2Down1OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ2Up1OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ1Down2OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ1Up2OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ2Down2OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ2Up2OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ1SuctionOnOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ1SuctionOffOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ1ReelCutBlowOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ2SuctionOnOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ2SuctionOffOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodeAlignSuctionOnOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodeAlignSuctionOffOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPX1FwdOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPX1BwdOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPX2FwdOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPX2BwdOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ1Down1OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ1Up1OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ2Down1OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ2Up1OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ1Down2OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ1Up2OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ2Down2OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ2Up2OutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ1SuctionOnOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ1SuctionOffOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ1ReelCutBlowOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ2SuctionOnOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ2SuctionOffOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodeAlignSuctionOnOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodeAlignSuctionOffOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetFinalRollerXFwdOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetFinalRollerXBwdOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetFinalRollerXStackTableDownOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetFinalRollerXStackAnodeVisionOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetFinalRollerXStackCathodeVisionOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnPZ1ReelCutDataDeleteOnOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodePnP1XReelCutDataDeleteOffOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetAnodeAlignVisionOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnPZ1ReelCutDataDeleteOnOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodePnP1XReelCutDataDeleteOffOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
      instResetCathodeAlignVisionOutputCam {InstructionName := 'MC_RESET'; LibVersion := '9.0'} : MC_RESET;
   END_VAR

   VAR_TEMP 
      tempMasterVirtualAxis {InstructionName := 'TO_SynchronousAxis'; LibVersion := '9.0'} : REF_TO TO_SynchronousAxis;
      tempSlaveUnwinderVirtualAxis {InstructionName := 'TO_SynchronousAxis'; LibVersion := '9.0'} : REF_TO TO_SynchronousAxis;
      tempSynchronousAxis {InstructionName := 'TO_SynchronousAxis'; LibVersion := '9.0'} : REF_TO TO_SynchronousAxis;
      tempCam10k {InstructionName := 'TO_Cam_10k'; LibVersion := '9.0'} : REF_TO TO_Cam_10k;
      tempOutputCam {InstructionName := 'TO_OutputCam'; LibVersion := '9.0'} : REF_TO TO_OutputCam;
      tempDistances : LReal;
      tempRemain : LReal;
      tempCount : LReal;
      tempLineSpeed : LReal;
      tempTime : LReal;
   END_VAR

   VAR CONSTANT 
      STAT_IDLE : DInt := 0;
      STAT_ERROR : DInt := 99;
      STAT_START : DInt := 100;
      STAT_RESET : DInt := 110;
      STAT_DONE : DInt := 10000;
   END_VAR


BEGIN
	REGION TECHNOLOGY OBJECT
	    REGION AXIS                                                                         // Axis Mapping 영역
	        #tempMasterVirtualAxis ?= #Axis.MasterVirtual;                                       // Master Virtual Axis 할당
	        #tempSlaveUnwinderVirtualAxis ?= #Axis.UnwinderVirtual;                              // Slave Unwinder Virtual Axis 할당
	    END_REGION
	END_REGION
	
	REGION INPUT SIGNAL
	    REGION EXECUTE
	        IF NOT #Execute THEN                                                            // Execute := False 상태 시 IDLE 상태로 초기화
	            #statBeforeCmd := #statNowCmd;                                              // 이전 명령 모니터링
	            #statNowCmd := #STAT_IDLE;                                                  // STAT_IDLE 상태로 이동 
	        END_IF;
	        
	        #instTriggerExecute(CLK := #Execute);                                           // 상승 에지 검출
	        
	        IF #instTriggerExecute.Q THEN                                                   // 상승 에지 검출 시
	            #statStartTime := TIME_TCK();
	            #statBeforeCmd := #statNowCmd;                                              // 이전 명령 모니터링
	            #statNowCmd := #STAT_START;                                                 // STAT_START 상태 돌입
	        END_IF;
	    END_REGION
	END_REGION
	
	REGION COMMAND
	    CASE #statNowCmd OF
	        #STAT_IDLE:
	            REGION IDLE
	                ;
	            END_REGION
	            
	        #STAT_ERROR:
	            REGION ERROR
	                ;
	            END_REGION
	            
	        #STAT_START:
	            REGION START
	                #statEndTime := TIME_TCK();
	                #statTimeTable[#STAT_START / 10 - 9] := #statEndTime - #statStartTime;
	                #statStartTime := TIME_TCK();
	                #statBeforeCmd := #statNowCmd;                                          // 이전 명령 모니터링
	                #statNowCmd := #STAT_RESET;                                              // STAT_AUTO_CHECK 상태 돌입
	            END_REGION
	    
	        #STAT_RESET:
	            REGION RESET
	                REGION DONE                                                             // 모든 축의 Reset 동작이 완료 시
	                    IF #instResetMasterVirtualAxis.Done
	                        AND #instResetUnwinderVirtualAxis.Done
	                        AND #instResetFinalRoller.Done
	                        AND #instResetCompensator.Done
	                        AND #instResetAnodePnPX1.Done
	                        AND #instResetAnodePnPX2.Done
	                        AND #instResetAnodePnPZ1.Done
	                        AND #instResetAnodePnPZ2.Done
	                        AND #instResetCathodePnPX1.Done
	                        AND #instResetCathodePnPX2.Done
	                        AND #instResetCathodePnPZ1.Done
	                        AND #instResetCathodePnPZ2.Done
	                        AND #instResetAnodeMandrelYFront.Done
	                        AND #instResetAnodeMandrelYRear.Done
	                        AND #instResetAnodeMandrelZFront.Done
	                        AND #instResetAnodeMandrelZRear.Done
	                        AND #instResetCathodeMandrelYFront.Done
	                        AND #instResetCathodeMandrelYRear.Done
	                        AND #instResetCathodeMandrelZFront.Done
	                        AND #instResetCathodeMandrelZRear.Done
	                        AND #instResetFinalRollerCam.Done
	                        AND #instResetCompensatorCam.Done
	                        AND #instResetAnodePnPX1Cam.Done
	                        AND #instResetAnodePnPX2Cam.Done
	                        AND #instResetAnodePnPZ1Cam.Done
	                        AND #instResetAnodePnPZ2Cam.Done
	                        AND #instResetCathodePnPX1Cam.Done
	                        AND #instResetCathodePnPX2Cam.Done
	                        AND #instResetCathodePnPZ1Cam.Done
	                        AND #instResetCathodePnPZ2Cam.Done
	                        AND #instResetAnodeMandrelYFrontCam.Done
	                        AND #instResetAnodeMandrelYRearCam.Done
	                        AND #instResetAnodeMandrelZFrontCam.Done
	                        AND #instResetAnodeMandrelZRearCam.Done
	                        AND #instResetCathodeMandrelYFrontCam.Done
	                        AND #instResetCathodeMandrelYRearCam.Done
	                        AND #instResetCathodeMandrelZFrontCam.Done
	                        AND #instResetCathodeMandrelZRearCam.Done
	                        AND #instResetFinalRollerXFwdOutputCam.Done
	                        AND #instResetFinalRollerXBwdOutputCam.Done
	                        AND #instResetFinalRollerXStackTableDownOutputCam.Done
	                        AND #instResetFinalRollerXStackAnodeVisionOutputCam.Done
	                        AND #instResetFinalRollerXStackCathodeVisionOutputCam.Done
	                        AND #instResetAnodePnPX1FwdOutputCam.Done
	                        AND #instResetAnodePnPX1BwdOutputCam.Done
	                        AND #instResetAnodePnPX2FwdOutputCam.Done
	                        AND #instResetAnodePnPX2BwdOutputCam.Done
	                        AND #instResetAnodePnPZ1Down1OutputCam.Done
	                        AND #instResetAnodePnPZ1Up1OutputCam.Done
	                        AND #instResetAnodePnPZ2Down1OutputCam.Done
	                        AND #instResetAnodePnPZ2Up1OutputCam.Done
	                        AND #instResetAnodePnPZ1Down2OutputCam.Done
	                        AND #instResetAnodePnPZ1Up2OutputCam.Done
	                        AND #instResetAnodePnPZ2Down2OutputCam.Done
	                        AND #instResetAnodePnPZ2Up2OutputCam.Done
	                        AND #instResetAnodePnPZ1SuctionOnOutputCam.Done
	                        AND #instResetAnodePnPZ1SuctionOffOutputCam.Done
	                        AND #instResetAnodePnPZ1ReelCutBlowOutputCam.Done
	                        AND #instResetAnodePnPZ2SuctionOnOutputCam.Done
	                        AND #instResetAnodePnPZ2SuctionOffOutputCam.Done
	                        AND #instResetAnodeAlignSuctionOnOutputCam.Done
	                        AND #instResetAnodeAlignSuctionOffOutputCam.Done
	                        AND #instResetAnodePnPZ1ReelCutDataDeleteOnOutputCam.Done
	                        AND #instResetAnodePnP1XReelCutDataDeleteOffOutputCam.Done
	                        AND #instResetAnodeAlignVisionOutputCam.Done
	                        AND #instResetCathodePnPX1FwdOutputCam.Done
	                        AND #instResetCathodePnPX1BwdOutputCam.Done
