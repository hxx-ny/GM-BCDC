	REGION OUTPUT SIGNAL                                                                      // 각 커맨드 동작 시 Busy 출력
	    #Busy := #statNowCmd = #STAT_START
	    OR #statNowCmd = #STAT_HOME
	    OR #statNowCmd = #STAT_CONTINUE
	    OR #statNowCmd = #STAT_GEAR_IN
	    OR #statNowCmd = #STAT_CAM_IN1
	    OR #statNowCmd = #STAT_MOVE_REL;
	    #Done := #statNowCmd = #STAT_DONE;
	    #Error := #statNowCmd = #STAT_ERROR;
	    #NowCmd := #statNowCmd;
	    #BeforeCmd := #statBeforeCmd;
	END_REGION
	
END_FUNCTION_BLOCK

