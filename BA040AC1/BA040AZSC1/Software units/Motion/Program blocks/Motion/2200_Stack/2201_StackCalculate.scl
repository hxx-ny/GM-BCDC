	REGION OUTPUT SIGNAL                                                            // 각 커맨드 동작 시 Busy 출력
	    #Busy := #statNowCmd = #STAT_START
	    OR #statNowCmd = #STAT_CAL_FINAL
	    OR #statNowCmd = #STAT_CAL_BWD
	    OR #statNowCmd = #STAT_CAL_FWD
	    OR #statNowCmd = #STAT_CAL_COMP
	    OR #statNowCmd = #STAT_CAL_APNP_X1
	    OR #statNowCmd = #STAT_CAL_APNP_X2
	    OR #statNowCmd = #STAT_CAL_APNP_Z1
	    OR #statNowCmd = #STAT_CAL_APNP_Z2
	    OR #statNowCmd = #STAT_CAL_CPNP_X1
	    OR #statNowCmd = #STAT_CAL_CPNP_X2
	    OR #statNowCmd = #STAT_CAL_CPNP_Z1
	    OR #statNowCmd = #STAT_CAL_CPNP_Z2
	    OR #statNowCmd = #STAT_CAL_MAN_FRONT_Y1
	    OR #statNowCmd = #STAT_CAL_MAN_REAR_Y1
	    OR #statNowCmd = #STAT_CAL_MAN_FRONT_Z1
	    OR #statNowCmd = #STAT_CAL_MAN_REAR_Z1
	    OR #statNowCmd = #STAT_CAL_MAN_FRONT_Y2
	    OR #statNowCmd = #STAT_CAL_MAN_REAR_Y2
	    OR #statNowCmd = #STAT_CAL_MAN_FRONT_Z2
	    OR #statNowCmd = #STAT_CAL_MAN_REAR_Z2;
	    #Done := #statNowCmd = #STAT_DONE;
	    #Error := #statNowCmd = #STAT_ERROR;
	    #NowCmd := #statNowCmd;
	    #BeforeCmd := #statBeforeCmd;
	END_REGION
END_FUNCTION_BLOCK

