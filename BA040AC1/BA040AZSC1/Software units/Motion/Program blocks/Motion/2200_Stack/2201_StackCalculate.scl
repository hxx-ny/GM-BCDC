	REGION INSTANCES                                                                // 각 캠 계산에 따른 인스턴스 DB 호출 영역
	    #tempFinalRollerDistance := #FinalRollerDistance;
	    REGION COMPENSATOR
	        #instCalculateCompensator(execute := #statNowCmd = #STAT_CAL_COMP,
	                                  cam := #CompensatorCam,
	                                  cpm := #CPM,
	                                  lineSpeed := #statLineSpeed,
	                                  distance := #tempFinalRollerDistance,
	                                  ratioOption := #RatioOption,
	                                  startRatio := #Ratio.FinalRollerStart,
	                                  endRatio := #Ratio.FinalRollerEnd,
	                                  timeOption := #TimeOption,
	                                  startTime := #Time.FinalRollerStart,
	                                  endTime := #Time.FinalRollerEnd,
	                                  accRatio := #AccRatio,
	                                  width := #StageWidth,
	                                  height := #StageHeight,
	                                  gap := #StageGap,
	                                  EmptyPoint := #EmptyPoint,
	                                  EmptySegment := #EmptySegment);
	    END_REGION
	    
	    REGION FINAL ROLLER
	        IF #Direction THEN
	            #tempFinalRollerDistance := #FinalRollerDistance;
	        ELSE
	            #tempFinalRollerDistance := - #FinalRollerDistance;
	        END_IF;
	        
	        REGION MAIN
	            #instCalculateFinalRoller(cam := #FinalRollerCam,
	                                      execute := #statNowCmd = #STAT_CAL_FINAL,
	                                      cpm := #CPM,
	                                      lineSpeed := #statLineSpeed,
	                                      distance := #tempFinalRollerDistance,
	                                      ratioOption := #RatioOption,
	                                      startRatio := #Ratio.FinalRollerStart,
	                                      endRatio := #Ratio.FinalRollerEnd,
