	                                      endTime := #Time.FinalRollerEnd,
	                                      accRatio := #AccRatio,
	                                      EmptyPoint := #EmptyPoint,
	                                      EmptySegment := #EmptySegment);
	        END_REGION
	        
	        REGION BWD
	            #instCalculateBwdTime(execute := #statNowCmd = #STAT_CAL_BWD,
	                                  cpm := #CPM,
	                                  lineSpeed := #statLineSpeed,
	                                  distance := #tempFinalRollerDistance,
	                                  ratioOption := #RatioOption,
	                                  startRatio := #Ratio.FinalRollerStart,
