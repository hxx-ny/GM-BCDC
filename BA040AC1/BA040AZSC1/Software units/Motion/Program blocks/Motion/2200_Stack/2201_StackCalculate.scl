FUNCTION_BLOCK "2201_StackCalculate"
{ S7_Optimized_Access := 'TRUE' ; Published := 'FALSE' }
VERSION : 0.1
   VAR_INPUT 
      Execute : Bool;
      Direction : Bool;
      CPM : LReal;
      StageWidth : LReal;
      StageHeight : LReal;
      StageGap : LReal;
      AccRatio : DInt;
      RatioOption : Bool;
      TimeOption : Bool;
      PosOption : Bool;
      DoubleOption : Bool;
      Ratio : Struct
         FinalRollerStart : LReal;
         FinalRollerEnd : LReal;
         PnPXStart : LReal;
         PnPXEnd : LReal;
         PnPZDownStart : LReal;
         PnPZDownEnd : LReal;
         PnPZUpStart : LReal;
         PnPZUpEnd : LReal;
         MandrelBwdStart : LReal;
         MandrelBwdEnd : LReal;
         MandrelFwdStart : LReal;
         MandrelFwdEnd : LReal;
         MandrelUpStart1 : LReal;
         MandrelUpEnd1 : LReal;
         MandrelUpStart2 : LReal;
         MandrelUpEnd2 : LReal;
         MandrelDownStart : LReal;
         MandrelDownEnd : LReal;
         MandrelYTerm : LReal;
         MandrelZTerm : LReal;
         MandrelBwdOffset : LReal;
         MandrelFwdOffset : LReal;
      END_STRUCT;
      "Time" : Struct
         FinalRollerStart : LReal;
         FinalRollerEnd : LReal;
         PnPXStart : LReal;
         PnPXEnd : LReal;
         PnPZDownStart : LReal;
         PnPZDownEnd : LReal;
         PnPZUpStart : LReal;
         PnPZUpEnd : LReal;
         MandrelBwdStart : LReal;
         MandrelBwdEnd : LReal;
         MandrelFwdStart : LReal;
         MandrelFwdEnd : LReal;
         MandrelUpStart1 : LReal;
         MandrelUpEnd1 : LReal;
         MandrelUpStart2 : LReal;
         MandrelUpEnd2 : LReal;
         MandrelDownStart : LReal;
         MandrelDownEnd : LReal;
      END_STRUCT;
      Position : Struct
         FinalRollerBwdPos : LReal;
         FinalRollerFwdPos : LReal;
      END_STRUCT;
      FinalRollerDistance : LReal;
      AnodePnPX1Distance : LReal;
      AnodePnPX2Distance : LReal;
      CathodePnPX1Distance : LReal;
      CathodePnPX2Distance : LReal;
      AnodePnPZ1Distance1 : LReal;
      AnodePnPZ1Distance2 : LReal;
      AnodePnPZ2Distance1 : LReal;
      AnodePnPZ2Distance2 : LReal;
      CathodePnPZ1Distance1 : LReal;
      CathodePnPZ1Distance2 : LReal;
      CathodePnPZ2Distance1 : LReal;
      CathodePnPZ2Distance2 : LReal;
      AnodeMandrelYFrontDistance : LReal;
      AnodeMandrelYRearDistance : LReal;
      CathodeMandrelYFrontDistance : LReal;
      CathodeMandrelYRearDistance : LReal;
      AnodeMandrelZFrontDistance : LReal;
      AnodeMandrelZRearDistance : LReal;
      CathodeMandrelZFrontDistance : LReal;
      CathodeMandrelZRearDistance : LReal;
   END_VAR

   VAR_OUTPUT 
      Done : Bool;
      Busy : Bool;
      Error : Bool;
      ErrorID : DWord;
      StatusID : DWord;
      NowCmd : DInt;
      BeforeCmd : DInt;
   END_VAR

   VAR_IN_OUT 
      EmptyPoint {InstructionName := 'TO_Cam_Struct_PointData'; LibVersion := '9.0'} : Array[1..10000] of TO_Cam_Struct_PointData;
      EmptySegment {InstructionName := 'TO_Cam_Struct_SegmentData'; LibVersion := '9.0'} : Array[1..50] of TO_Cam_Struct_SegmentData;
      FinalRollerCam : DB_ANY;
      CompensatorCam : DB_ANY;
      AnodePnPX1Cam : DB_ANY;
      AnodePnPX2Cam : DB_ANY;
      AnodePnPZ1Cam : DB_ANY;
      AnodePnPZ2Cam : DB_ANY;
      CathodePnPX1Cam : DB_ANY;
      CathodePnPX2Cam : DB_ANY;
      CathodePnPZ1Cam : DB_ANY;
      CathodePnPZ2Cam : DB_ANY;
      AnodeMandrelYFrontCam : DB_ANY;
      AnodeMandrelYRearCam : DB_ANY;
      AnodeMandrelZFrontCam : DB_ANY;
      AnodeMandrelZRearCam : DB_ANY;
      CathodeMandrelYFrontCam : DB_ANY;
      CathodeMandrelYRearCam : DB_ANY;
      CathodeMandrelZFrontCam : DB_ANY;
      CathodeMandrelZRearCam : DB_ANY;
   END_VAR

   VAR 
      statNowCmd : DInt;
      statBeforeCmd : DInt;
      statLineSpeed : LReal;
      statTargetBwdTime : LReal;
      statTargetFwdTime : LReal;
      statTimeTable : Array[1..50] of Time;
      statStartTime : Time;
      statEndTime : Time;
      instTriggerExecute {InstructionName := 'R_TRIG'; LibVersion := '1.0'; S7_SetPoint := 'False'} : R_TRIG;
      instCalculateFinalRoller : "2303_CalculateCam_FinalRoller";
      instCalculateBwdTime : "2304_CalculateCam_FinalTime";
      instCalculateFwdTime : "2304_CalculateCam_FinalTime";
      instCalculateCompensator : "2305_CalculateCam_Compensator";
      instCalculateAnodePnPX1 : "2301_CalculateCam_PnPX";
      instCalculateAnodePnPX2 : "2301_CalculateCam_PnPX";
      instCalculateAnodePnPZ1 : "2302_CalculateCam_PnPZ";
      instCalculateAnodePnPZ2 : "2302_CalculateCam_PnPZ";
      instCalculateCathodePnPX1 : "2301_CalculateCam_PnPX";
      instCalculateCathodePnPX2 : "2301_CalculateCam_PnPX";
      instCalculateCathodePnPZ1 : "2302_CalculateCam_PnPZ";
      instCalculateCathodePnPZ2 : "2302_CalculateCam_PnPZ";
      instCalculateMandrelYFront1 : "2307_CalculateCam_MandrelY1";
      instCalculateMandrelYRear1 : "2307_CalculateCam_MandrelY1";
      instCalculateMandrelZFront1 : "2306_CalculateCam_MandrelZ1";
      instCalculateMandrelZRear1 : "2306_CalculateCam_MandrelZ1";
      instCalculateMandrelYFront2 : "2309_CalculateCam_MandrelY2";
      instCalculateMandrelYRear2 : "2309_CalculateCam_MandrelY2";
      instCalculateMandrelZFront2 : "2308_CalculateCam_MandrelZ2";
      instCalculateMandrelZRear2 : "2308_CalculateCam_MandrelZ2";
   END_VAR

   VAR_TEMP 
      tempFinalRollerDistance : LReal;
      tempAnodePnPX1Distance : LReal;
      tempAnodePnPX2Distance : LReal;
      tempCathodePnPX1Distance : LReal;
      tempCathodePnPX2Distance : LReal;
      tempAnodePnPZ1Distance1 : LReal;
      tempAnodePnPZ1Distance2 : LReal;
      tempAnodePnPZ2Distance1 : LReal;
      tempAnodePnPZ2Distance2 : LReal;
      tempCathodePnPZ1Distance1 : LReal;
      tempCathodePnPZ1Distance2 : LReal;
      tempCathodePnPZ2Distance1 : LReal;
      tempCathodePnPZ2Distance2 : LReal;
      tempMandrelYFrontCam1 : DB_ANY;
      tempMandrelYRearCam1 : DB_ANY;
      tempMandrelZFrontCam1 : DB_ANY;
      tempMandrelZRearCam1 : DB_ANY;
      tempMandrelYFrontCam2 : DB_ANY;
      tempMandrelYRearCam2 : DB_ANY;
      tempMandrelZFrontCam2 : DB_ANY;
      tempMandrelZRearCam2 : DB_ANY;
      tempMandrelYFrontDistance1 : LReal;
      tempMandrelYRearDistance1 : LReal;
      tempMandrelZFrontDistance1 : LReal;
      tempMandrelZRearDistance1 : LReal;
      tempMandrelYFrontDistance2 : LReal;
      tempMandrelYRearDistance2 : LReal;
      tempMandrelZFrontDistance2 : LReal;
      tempMandrelZRearDistance2 : LReal;
   END_VAR

   VAR CONSTANT 
      STAT_IDLE : DInt := 0;
      STAT_ERROR : DInt := 99;
      STAT_START : DInt := 100;
      STAT_CAL_FINAL : DInt := 110;
      STAT_CAL_BWD : DInt := 120;
      STAT_CAL_FWD : DInt := 130;
      STAT_CAL_COMP : DInt := 140;
      STAT_CAL_APNP_X1 : DInt := 150;
      STAT_CAL_APNP_X2 : DInt := 160;
      STAT_CAL_APNP_Z1 : DInt := 170;
      STAT_CAL_APNP_Z2 : DInt := 180;
      STAT_CAL_CPNP_X1 : DInt := 190;
      STAT_CAL_CPNP_X2 : DInt := 200;
      STAT_CAL_CPNP_Z1 : DInt := 210;
      STAT_CAL_CPNP_Z2 : DInt := 220;
      STAT_CAL_MAN_FRONT_Y1 : DInt := 230;
      STAT_CAL_MAN_REAR_Y1 : DInt := 240;
      STAT_CAL_MAN_FRONT_Z1 : DInt := 250;
      STAT_CAL_MAN_REAR_Z1 : DInt := 260;
      STAT_CAL_MAN_FRONT_Y2 : DInt := 270;
      STAT_CAL_MAN_REAR_Y2 : DInt := 280;
      STAT_CAL_MAN_FRONT_Z2 : DInt := 290;
      STAT_CAL_MAN_REAR_Z2 : DInt := 300;
      STAT_DONE : DInt := 10000;
   END_VAR


BEGIN
	
	REGION INPUT SIGNAL
	    REGION EXECUTE
	        IF NOT #Execute THEN
	            #statBeforeCmd := #statNowCmd;                                      // 이전 명령 모니터링
	            #statNowCmd := #STAT_IDLE;
	        END_IF;
	        
	        #instTriggerExecute(CLK := #Execute);
	        
	        IF #instTriggerExecute.Q THEN
	            #statLineSpeed := 0.0;
	            #statStartTime := TIME_TCK();
	            #statBeforeCmd := #statNowCmd;                                      // 이전 명령 모니터링
	            #statNowCmd := #STAT_START;
	        END_IF;
	    END_REGION
	END_REGION
	
	REGION COMMAND
	    CASE #statNowCmd OF
	        #STAT_IDLE:
	            REGION IDLE
	                ;
	            END_REGION
	            
	        #STAT_ERROR:
	            REGION ERROR
	                ;
	            END_REGION
	            
	        #STAT_START:
	            REGION STEP START
	                #statLineSpeed := #CPM * #StageWidth / 60.0;                    // 선속 = CPM * 스테이지 폭 / 60
	                #statTargetBwdTime := 0.0;                                      // FinalRoller 전후진 시간 파라미터 초기화
	                #statTargetFwdTime := 0.0;                                      // FinalRoller 전후진 시간 파라미터 초기화
	                #statEndTime := TIME_TCK();
	                #statTimeTable[#STAT_START / 10 - 9] := #statEndTime - #statStartTime;
	                #statStartTime := TIME_TCK();
	                #statBeforeCmd := #statNowCmd;                                  // 이전 명령 모니터링
	                #statNowCmd := #STAT_CAL_FINAL;                                 // STAT_CAL_FINAL 상태로 이동
	            END_REGION
	            
	        #STAT_CAL_FINAL:                                                        // Final Roller 캠 계산 영역
	            REGION CALCULATE FINAL ROLLER
	                REGION DONE                                                     // Final Roller 캠 계산 완료 시
	                    IF #instCalculateFinalRoller.done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_CAL_FINAL / 10 - 9] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_CAL_BWD;                           // STAT_CAL_BWD 상태로 이동
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                                    //Final Roller 캠 계산 중 에러 발생 시
	                    IF #instCalculateFinalRoller.error THEN
	                        #ErrorID := #instCalculateFinalRoller.errorID;          // FinalRoller 에러ID 출력
	                        #StatusID := 16#2600_3010;
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                             // STAT_ERROR 상태로 이동
	                    END_IF;
	                END_REGION
	            END_REGION
	            
	        #STAT_CAL_BWD:                                                          // Final Roller BWD Time 캠 계산 영역
	            REGION CALCULATE BWD TIME
	                REGION DONE                                                     // Final Roller BWD Time 캠 계산 완료 시 
	                    IF #instCalculateBwdTime.done THEN
	                        #statTargetBwdTime := #instCalculateBwdTime.targetTime; // Mandrel Bwd Time 파라미터로 사용
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_CAL_BWD / 10 - 9] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_CAL_FWD;                           // STAT_CAL_FWD 상태로 이동
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                                    // Final Roller BWD Time 캠 계산 중 에러 발생 시
	                    IF #instCalculateBwdTime.error THEN
	                        #ErrorID := #instCalculateBwdTime.errorID;              // Final BWD Time 에러ID 출력
	                        #StatusID := 16#2600_3012;
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                             // STAT_ERROR 상태로 이동
	                    END_IF;
	                END_REGION
	            END_REGION
	            
	        #STAT_CAL_FWD:                                                          // Final Roller FWD Time 캠 계산 영역
	            REGION CALCULATE FWD TIME
	                REGION DONE                                                     // Final Roller FWD Time 캠 계산 완료 시
	                    IF #instCalculateFwdTime.done THEN
	                        #statTargetFwdTime := #instCalculateFwdTime.targetTime; // Mandrel Fwd Time 파라미터로 사용
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_CAL_FWD / 10 - 9] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_CAL_COMP;                          // STAT_CAL_COMP 상태로 이동
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                                    // Final Roller FWD Time 캠 계산 중 에러 발생 시
	                    IF #instCalculateFwdTime.error THEN
	                        #ErrorID := #instCalculateFwdTime.errorID;              // Final FWD Time 에러ID 출력
	                        #StatusID := 16#2600_3011;
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                             // STAT_ERROR 상태로 이동
	                    END_IF;
	                END_REGION
	            END_REGION
	            
	        #STAT_CAL_COMP:                                                         // Compensator 캠 계산 영역
	            REGION CALCULATE COMPENSATOR
	                REGION DONE                                                     // Compensator 캠 계산 완료 시
	                    IF #instCalculateCompensator.done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_CAL_COMP / 10 - 9] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_CAL_APNP_X1;                       // STAT_CAL_APNP_X1 상태로 이동
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                                    // Compensator 캠 계산 중 에러 발생 시
	                    IF #instCalculateCompensator.error THEN
	                        #ErrorID := #instCalculateCompensator.errorID;          // Compensator 에러ID 출력
	                        #StatusID := 16#0600_3010;
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                             // STAT_ERROR 상태로 이동
	                    END_IF;
	                END_REGION
	            END_REGION
	            
	        #STAT_CAL_APNP_X1:                                                      // Anode PnP X1 캠 계산 영역
	            REGION CALCULATE ANODE PNP X1
	                REGION DONE                                                     // Anode PnP X1 캠 계산 완료 시
	                    IF #instCalculateAnodePnPX1.done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_CAL_APNP_X1 / 10 - 9] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_CAL_APNP_X2;                       // STAT_CAL_APNP_X2 상태로 이동
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                                    // Anode PnP X1 캠 계산 중 에러 발생 시
	                    IF #instCalculateAnodePnPX1.error THEN                      // Anode PnP X1 에러ID 출력
	                        #ErrorID := #instCalculateAnodePnPX1.errorID;
	                        #StatusID := 16#0800_3010;
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                             // STAT_ERROR 상태로 이동
	                    END_IF;
	                END_REGION
	            END_REGION
	            
	        #STAT_CAL_APNP_X2:                                                      // Anode PnP X2 캠 계산 영역
	            REGION CALCULATE ANODE PNP X2
	                REGION DONE                                                     // Anode PnP X2 캠 계산 완료 시
	                    IF #instCalculateAnodePnPX2.done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_CAL_APNP_X2 / 10 - 9] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_CAL_APNP_Z1;                       // STAT_CAL_APNP_Z1 상태로 이동
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                                    // Anode PnP X2 캠 계산 중 에러 발생 시
	                    IF #instCalculateAnodePnPX2.error THEN
	                        #ErrorID := #instCalculateAnodePnPX2.errorID;           // Anode PnP X2 에러ID 출력
	                        #StatusID := 16#0900_3010;
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                             // STAT_ERROR 상태로 이동
	                    END_IF;
	                END_REGION
	            END_REGION
	            
	        #STAT_CAL_APNP_Z1:                                                      // Anode PnP Z1 캠 계산 영역
	            REGION CALCULATE ANODE PNP Z1
	                REGION DONE                                                     // Anode PnP Z1 캠 계산 완료 시
	                    IF #instCalculateAnodePnPZ1.done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_CAL_APNP_Z1 / 10 - 9] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_CAL_APNP_Z2;                       // STAT_CAL_APNP_Z2 상태로 이동
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                                    // Anode PnP Z1 캠 계산 중 에러 발생 시
	                    IF #instCalculateAnodePnPZ1.error THEN
	                        #ErrorID := #instCalculateAnodePnPZ1.errorID;           // Anode PnP Z1 에러ID 출력
	                        #StatusID := 16#1200_3010;
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                             // STAT_ERROR 상태로 이동
	                    END_IF;
	                END_REGION
	            END_REGION
	            
	        #STAT_CAL_APNP_Z2:                                                      // Anode PnP Z2 캠 계산 영역
	            REGION CALCULATE ANODE PNP Z2 
	                REGION DONE                                                     // Anode PnP Z2 캠 계산 완료 시
	                    IF #instCalculateAnodePnPZ2.done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_CAL_APNP_Z2 / 10 - 9] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_CAL_CPNP_X1;                       // STAT_CAL_CPNP_X1 상태로 이동
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                                    // Anode PnP Z2 캠 계산 중 에러 발생 시
	                    IF #instCalculateAnodePnPZ2.error THEN
	                        #ErrorID := #instCalculateAnodePnPZ2.errorID;           // Anode PnP Z2 에러ID 출력
	                        #StatusID := 16#1300_3010;
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                             // STAT_ERROR 상태로 이동
	                    END_IF;
	                END_REGION
	            END_REGION
	            
	        #STAT_CAL_CPNP_X1:                                                      // Cathode PnP X1 캠 계산 영역
	            REGION CALCULATE CATHODE PNP X1 
	                REGION DONE                                                     // Cathode PnP X1 캠 계산 완료 시
	                    IF #instCalculateCathodePnPX1.done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_CAL_CPNP_X1 / 10 - 9] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_CAL_CPNP_X2;                       // STAT_CAL_CPNP_X2 상태로 이동
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                                    // Cathode PnP X1 캠 계산 중 에러 발생 시
	                    IF #instCalculateCathodePnPX1.error THEN
	                        #ErrorID := #instCalculateCathodePnPX1.errorID;         // Cathode PnP X1 에러ID 출력
	                        #StatusID := 16#1400_3010;
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                             // STAT_ERROR 상태로 이동
	                    END_IF;
	                END_REGION
	            END_REGION
	            
	        #STAT_CAL_CPNP_X2:                                                      // Cathode PnP X2 캠 계산 영역
	            REGION CALCULATE CATHODE PNP X2 
	                REGION DONE                                                     // Cathode PnP X2 캠 계산 완료 시
	                    IF #instCalculateCathodePnPX2.done THEN
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_CAL_CPNP_X2 / 10 - 9] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;                          // 이전 명령 모니터링
	                        #statNowCmd := #STAT_CAL_CPNP_Z1;                       // STAT_CAL_CPNP_Z1 상태로 이동
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                                    // Cathode PnP X2 캠 계산 중 에러 발생 시
	                    IF #instCalculateCathodePnPX2.error THEN
