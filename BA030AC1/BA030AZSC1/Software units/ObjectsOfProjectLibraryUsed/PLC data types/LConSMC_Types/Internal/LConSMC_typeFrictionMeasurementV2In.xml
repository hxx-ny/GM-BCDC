    <Member Name="execute" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Starte Messung mit steigender Flanke</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Start friction measurement with rising edge</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="abort" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Stoppe Messung und Achse mit steigender Flanke</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Rising edge stops measurement and axis</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="warmUpTime" Datatype="Time">
      <Comment>
        <MultiLanguageText Lang="de-DE">Warmlaufzeit  Vor Beginn der Messung dreht der Antrieb für die parametrierte Zeit mit der maximalen Messdrehzahl</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Warm up time  Before the measurement starts the drive rotates with maximum measurement speed for the parameterized time</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="rampTime" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">[ms] Time to ramp up to maximum speed</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[ms] Time to ramp up to maximum speed</MultiLanguageText>
      </Comment>
      <StartValue>1000.0</StartValue>
    </Member>
    <Member Name="noOfMeasurementPoints" Datatype="Int">
      <Comment>
        <MultiLanguageText Lang="de-DE">Anzahl an Messpunkten pro Drehzahlwert (Einstellbar zwischen 50-500)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Number measurement points per speed step (limited between 50-500)</MultiLanguageText>
      </Comment>
      <StartValue>50</StartValue>
    </Member>
    <Member Name="sizeOfArray" Datatype="Int">
      <Comment>
        <MultiLanguageText Lang="de-DE">maxSpeed = 0:  Anzahl der verwendeten Stützpunkte (aus "speedValues")  maxSpeed &lt;&gt; 0:  Anzahl an Messpunkten zwischen 0 und "maxSpeed"</MultiLanguageText>
        <MultiLanguageText Lang="en-US">maxSpeed = 0:  Number of breakpoints (from "speedValues")  maxSpeed &lt;&gt; 0:  Number of measuring points between 0 and "maxSpeed"</MultiLanguageText>
      </Comment>
      <StartValue>20</StartValue>
    </Member>
    <Member Name="maxSpeed" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">[1/min] Maximaldrehzahl für die die Reibung gemessen werden soll</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[RPM] Maximim speed at which the friction should be recorded</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
