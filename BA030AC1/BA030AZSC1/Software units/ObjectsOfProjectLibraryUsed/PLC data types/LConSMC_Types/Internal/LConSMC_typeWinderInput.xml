<?xml version="1.0" encoding="utf-8"?>
<Document>
  <Engineering version="V20" />
  <SW.Types.PlcStruct ID="0">
    <AttributeList>
      <Access>Published</Access>
      <Interface><Sections xmlns="http://www.siemens.com/automation/Openness/SW/Interface/v5">
  <Section Name="None">
    <Member Name="enable" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Enable function block. WIth rising edge a validation of parameter is done and communication with drive is started  FALSE: Disable the function block</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Enable function block. WIth rising edge a validation of parameter is done and communication with drive is started  FALSE: Disable the function block</MultiLanguageText>
      </Comment>
      <StartValue>FALSE</StartValue>
    </Member>
    <Member Name="speedMatch" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Enable web velocity setpoint ("lineAxisMotionVector"). The drive will synchronize up to web velocity using syncronization dynamics. If the velocity is reached the output "inSync" will become TRUE.  FALSE: Drive will decelerate to standstill using stop dynamics</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Enable web velocity setpoint ("lineAxisMotionVector"). The drive will synchronize up to web velocity using syncronization dynamics. If the velocity is reached the output "inSync" will become TRUE.  FALSE: Drive will decelerate to standstill using stop dynamics</MultiLanguageText>
      </Comment>
      <StartValue>FALSE</StartValue>
    </Member>
    <Member Name="cntrlEnable" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Enable web tension control (enable torque limits, dancer position setpoint etc.) </MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Enable web tension control (enable torque limits, dancer position setpoint etc.) </MultiLanguageText>
      </Comment>
      <StartValue>FALSE</StartValue>
    </Member>
    <Member Name="jogPos" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Drive is jogged in positive direction (see config.dynamics.jogDynamics)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Drive is jogged in positive direction (see config.dynamics.jogDynamics)</MultiLanguageText>
      </Comment>
      <StartValue>FALSE</StartValue>
    </Member>
    <Member Name="jogNeg" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Drive is jogged in negative direction (see config.dynamics.jogDynamics)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Drive is jogged in negative direction (see config.dynamics.jogDynamics)</MultiLanguageText>
      </Comment>
      <StartValue>FALSE</StartValue>
    </Member>
    <Member Name="lineAxisMotionVector" Datatype="&quot;LConSMC_typeMotionVector&quot;">
      <Comment>
        <MultiLanguageText Lang="de-DE">Setpoint of the web (position/velocity/acceleration)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Setpoint of the web (position/velocity/acceleration)</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="lineAxisActualValues" Datatype="&quot;LConSMC_typeLineAxisActValues&quot;">
      <Comment>
        <MultiLanguageText Lang="de-DE">Actual values of the web for diameter calculation.  Leading value (actual or setpoint values) must be connected to the input "lineAxisMotionVector"</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Actual values of the web for diameter calculation.  Leading value (actual or setpoint values) must be connected to the input "lineAxisMotionVector"</MultiLanguageText>
      </Comment>
    </Member>
    <Member Name="additionalVelocity" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">[m/min] / [ft/min] Additional web velocity (always enabled)</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[m/min] / [ft/min] Additional web velocity (always enabled)</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="typeOfWinder" Datatype="Int">
      <Comment>
        <MultiLanguageText Lang="de-DE">Definition of winding direction  0: Rewind from above  1: Rewind from below  2: Unwind from above  3: Unwind from below</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Definition of winding direction  0: Rewind from above  1: Rewind from below  2: Unwind from above  3: Unwind from below</MultiLanguageText>
      </Comment>
      <StartValue ConstantName="&quot;LCON_TYPE_OF_WINDER_REWIND_FROM_ABOVE&quot;" />
    </Member>
    <Member Name="controlMode" Datatype="Int">
      <Comment>
        <MultiLanguageText Lang="de-DE">Tension control mode  0: Dancer via speed setpoint adaption  1: Load cell via speed setpoint adaption  2: Load cell via torque limits  3: Indirect tension control  4: V-constant</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Tension control mode  0: Dancer via speed setpoint adaption  1: Load cell via speed setpoint adaption  2: Load cell via torque limits  3: Indirect tension control  4: Speed setpoint relation (Draw)  5: Indirect tension control vis speed setpoint adaption</MultiLanguageText>
      </Comment>
      <StartValue>0</StartValue>
    </Member>
    <Member Name="typeOfDiameterCalc" Datatype="Int">
      <Comment>
        <MultiLanguageText Lang="de-DE">Type of diameter calculation  0: V/n  1: Thickness addition  2: Integral  3: External  4: WebLength  5: Position</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Type of diameter calculation  0: V/n  1: Thickness addition  2: Integral  3: External  4: WebLength  5: Position</MultiLanguageText>
      </Comment>
      <StartValue ConstantName="&quot;LCON_DIAM_CALC_MODE_INTEGRAL&quot;" />
    </Member>
    <Member Name="holdDiameter" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Hold diameter calculation  FALSE: Diameter calculation is active</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Hold diameter calculation  FALSE: Diameter calculation is active</MultiLanguageText>
      </Comment>
      <StartValue>FALSE</StartValue>
    </Member>
    <Member Name="setDiameter" Datatype="Bool">
      <Comment>
        <MultiLanguageText Lang="de-DE">TRUE: Set diameter to the value in "winderConfig.diamConfig.diameterSetValue"</MultiLanguageText>
        <MultiLanguageText Lang="en-US">TRUE: Set diameter to the value in "winderConfig.diamConfig.diameterSetValue"</MultiLanguageText>
      </Comment>
      <StartValue>FALSE</StartValue>
    </Member>
    <Member Name="CntrlSetpoint" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">Tension setpoint [N]/[Lbf] / Dancer position setpoint [%]</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Tension setpoint [N]/[Lbf] / Dancer position setpoint [%]</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="CntrlActual" Datatype="LReal">
      <Comment>
        <MultiLanguageText Lang="de-DE">Tension actual value [N]/[Lbf] / Dancer actual position [%]</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Tension actual value [N]/[Lbf] / Dancer actual position [%]</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="tCycle" Datatype="Real">
      <Comment>
        <MultiLanguageText Lang="de-DE">[ms] Cycle time the function block is called</MultiLanguageText>
        <MultiLanguageText Lang="en-US">[ms] Cycle time the function block is called</MultiLanguageText>
      </Comment>
      <StartValue>0.0</StartValue>
    </Member>
    <Member Name="winderAxis" Datatype="DB_ANY">
      <Comment>
        <MultiLanguageText Lang="de-DE">Winder axis</MultiLanguageText>
        <MultiLanguageText Lang="en-US">Winder axis</MultiLanguageText>
      </Comment>
    </Member>
  </Section>
</Sections></Interface>
