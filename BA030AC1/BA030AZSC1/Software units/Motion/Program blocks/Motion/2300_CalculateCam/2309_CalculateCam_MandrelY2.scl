FUNCTION_BLOCK "2309_CalculateCam_MandrelY2"
{ S7_Optimized_Access := 'TRUE' ; Published := 'FALSE' }
VERSION : 0.1
   VAR_INPUT 
      execute : Bool;
      cpm : LReal;
      distance : LReal;
      lineSpeed : LReal;
      ratioOption : Bool;
      fwdStartRatio : LReal;
      fwdEndRatio : LReal;
      bwdStartRatio : LReal;
      bwdEndRatio : LReal;
      timeOption : Bool;
      fwdStartTime : LReal;
      fwdEndTime : LReal;
      bwdStartTime : LReal;
      bwdEndTime : LReal;
      posOption : Bool;
      fwdStartPos : LReal;
      bwdStartPos : LReal;
      zMoveRatio : LReal;
      yMoveRatio : LReal;
      zMoveOffset : LReal;
      accRatio { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : LInt := 2;
   END_VAR

   VAR_OUTPUT 
      done : Bool;
      busy : Bool;
      error : Bool;
      errorID : Word;
   END_VAR

   VAR_IN_OUT 
      cam : DB_ANY;
      EmptyPoint {InstructionName := 'TO_Cam_Struct_PointData'; LibVersion := '9.0'} : Array[1..10000] of TO_Cam_Struct_PointData;
      EmptySegment {InstructionName := 'TO_Cam_Struct_SegmentData'; LibVersion := '9.0'} : Array[1..50] of TO_Cam_Struct_SegmentData;
   END_VAR

   VAR 
      instMCInterpolateCam {InstructionName := 'MC_INTERPOLATECAM'; LibVersion := '9.0'; S7_SetPoint := 'False'} : MC_INTERPOLATECAM;
      instMCCopyCamData {InstructionName := 'MC_COPYCAMDATA'; LibVersion := '9.0'} : MC_COPYCAMDATA;
      statBusy : Bool;
      statDone : Bool;
      statCalculateCamState { S7_SetPoint := 'True'} : DInt;
      statTimeTable : Array[1..50] of Time;
      statStartTime : Time;
      statEndTime : Time;
      CalCulateTrigger {InstructionName := 'R_TRIG'; LibVersion := '1.0'; S7_SetPoint := 'False'} : R_TRIG;
   END_VAR

   VAR_TEMP 
      tempCam {InstructionName := 'TO_Cam_10k'; LibVersion := '9.0'} : REF_TO TO_Cam_10k;
      tempFCount : DInt;
      tempFullTime : LReal;
      tempCycleTime : LReal;
      tempStartTime : LReal;
      tempRestTime : LReal;
      tempTime : Array[1..50] of LReal;
      tempPos : Array[1..50] of LReal;
      tempVel : Array[1..50] of LReal;
      tempAcc : Array[1..50] of LReal;
      tempJerk : Array[1..50] of LReal;
      tempX : Array[1..50] of LReal;
      tempCalAcc : Array[1..50] of LReal;
      tempCalVel : Array[1..50] of LReal;
      tempCalPos : Array[1..50] of LReal;
      tempA3 : Array[1..50] of LReal;
      tempA2 : Array[1..50] of LReal;
      tempA1 : Array[1..50] of LReal;
      tempA0 : Array[1..50] of LReal;
   END_VAR

   VAR CONSTANT 
      PI : LReal := 3.14159265358979;
      CC_IDLE : DInt;
      CC_INITIALIZE1 : DInt := 1;
      CC_INITIALIZE2 : DInt := 2;
      CC_INITIALIZE3 : DInt := 3;
      CC_CALCULATE : DInt := 4;
      CC_INTERPOLATE : DInt := 5;
      CC_DONE : DInt := 6;
      CC_ERROR : DInt := 99;
   END_VAR


BEGIN
	REGION Mapping Cam
	    #tempCam ?= #cam;
	END_REGION
	
	REGION Error Check
	    REGION MC_INTERPOLATE
	        IF #instMCInterpolateCam.Error
	        THEN
	            #statCalculateCamState := #CC_ERROR;
	            #errorID := #instMCInterpolateCam.ErrorId;
	        END_IF;
	    END_REGION
	    
	    REGION ACC RATIO
	        IF #accRatio < 2
	        THEN
	            #statCalculateCamState := #CC_ERROR;
	            #errorID := 16#1000;
	        END_IF;
	    END_REGION
	    
	    REGION BIT PARAMETER
	        IF NOT #ratioOption AND NOT #timeOption THEN
	            #statCalculateCamState := #CC_ERROR;
	            #errorID := 16#1001;
	        END_IF;
	    END_REGION
	    
	    REGION RATIO PARAMETER CHECK
	        IF #ratioOption THEN
	            IF #fwdStartRatio < 0.0
	                OR #fwdEndRatio < 0.0
	                OR #bwdStartRatio < 0.0
	                OR #bwdEndRatio < 0.0
	                OR #fwdStartRatio > 100.0
	                OR #fwdEndRatio > 100.0
	                OR #bwdStartRatio > 100.0
	                OR #bwdEndRatio > 100.0
	                OR #fwdEndRatio - #fwdStartRatio >= 50.0
	                OR #bwdEndRatio - #bwdStartRatio >= 50.0
	                OR #bwdStartRatio > #bwdEndRatio
	                OR #bwdEndRatio > #fwdStartRatio
	                OR #fwdStartRatio > #fwdEndRatio
	            THEN
	                #statCalculateCamState := #CC_ERROR;
	                #errorID := 16#1002;
	            END_IF;
	        END_IF;
	    END_REGION
	    
	    REGION TIME PARAMETER CHECK
	        IF #timeOption THEN
	            #tempFullTime := 60000.0 / #cpm;
	            IF #fwdStartTime < 0.0
	                OR #fwdEndTime < 0.0
	                OR #bwdStartTime < 0.0
	                OR #bwdEndTime < 0.0
	                OR #fwdStartTime > 100.0
	                OR #fwdEndTime > 100.0
	                OR #bwdStartTime > 100.0
	                OR #bwdEndTime > 100.0
	                OR #fwdEndTime - #fwdStartTime >= #tempFullTime / 2.0
	                OR #bwdEndTime - #bwdStartTime >= #tempFullTime / 2.0
	                OR #fwdStartTime > #fwdEndTime
	                OR #fwdEndTime > #bwdStartTime
	                OR #bwdStartTime > #bwdEndTime
	            THEN
	                #statCalculateCamState := #CC_ERROR;
	                #errorID := 16#1003;
	            END_IF;
	        END_IF;
	    END_REGION
	    
	    REGION BASIC PARAMETER CHECK
	        IF #cpm <= 0.0
	            OR #lineSpeed <= 0.0
	            OR ABS_LREAL(#distance) = 0.0
	        THEN
	            #statCalculateCamState := #CC_ERROR;
	            #errorID := 16#1004;
	        END_IF;
	    END_REGION
	END_REGION
	
	REGION Execute
	    IF NOT #execute
	    THEN
	        #statCalculateCamState := #CC_IDLE;
	    END_IF;
	    IF #statCalculateCamState <> #CC_ERROR
	    THEN
	        #CalCulateTrigger(CLK := #execute);
	    END_IF;
	    IF #CalCulateTrigger.Q THEN
	        #instMCCopyCamData.NumberOfPoints := 10000;
	        #instMCCopyCamData.NumberOfSegments := 50;
	        #statStartTime := TIME_TCK();
	        #statCalculateCamState := #CC_INITIALIZE1;
	    END_IF;
	END_REGION
	
	REGION State Machine
	    CASE #statCalculateCamState OF
	        #CC_IDLE:
	            REGION READY
	                ;
	            END_REGION
	            
	        #CC_INITIALIZE1:
	            REGION INITIALIZE1
	                #tempFCount := 0;
	                FOR #tempFCount := 1 TO 10000 DO
	                    #tempCam^.Point[#tempFCount].x := 0.0;
	                    #tempCam^.Point[#tempFCount].y := 0.0;
	                    #tempCam^.ValidPoint[#tempFCount] := FALSE;
	                END_FOR;
	                
	                #tempFCount := 0;
	                FOR #tempFCount := 1 TO 50 DO
	                    #tempCam^.Segment[#tempFCount].a0 := 0.0;
	                    #tempCam^.Segment[#tempFCount].a1 := 0.0;
	                    #tempCam^.Segment[#tempFCount].a2 := 0.0;
	                    #tempCam^.Segment[#tempFCount].a3 := 0.0;
	                    #tempCam^.Segment[#tempFCount].a4 := 0.0;
	                    #tempCam^.Segment[#tempFCount].a5 := 0.0;
	                    #tempCam^.Segment[#tempFCount].a6 := 0.0;
	                    #tempCam^.Segment[#tempFCount].sineAmplitude := 0.0;
	                    #tempCam^.Segment[#tempFCount].sinePeriod := 0.0;
	                    #tempCam^.Segment[#tempFCount].sinePhase := 0.0;
	                    #tempCam^.Segment[#tempFCount].xmax := 0.0;
	                    #tempCam^.Segment[#tempFCount].xmin := 0.0;
	                    #tempCam^.ValidSegment[#tempFCount] := FALSE;
	                END_FOR;
	                
	                
	                #statCalculateCamState := #CC_CALCULATE;
	                
	            END_REGION
	            
	        #CC_CALCULATE:
	            REGION CALCULATE
	                #tempCycleTime := 60000.0 / #cpm;
	                IF #posOption THEN
	                    REGION POSITION
	                        #tempTime[1] := 0.0;
	                        #tempTime[2] := #lineSpeed * #tempCycleTime / 1000.0;
	                        #tempTime[3] := #lineSpeed * (#bwdStartPos + #tempCycleTime * #zMoveOffset / 100.0) / 1000.0;
	                        #tempTime[4] := #lineSpeed * #tempCycleTime * #yMoveRatio / 100.0 / 1000.0;
	                        #tempTime[5] := #lineSpeed * (#fwdStartPos - #bwdStartPos - #tempCycleTime * #yMoveRatio / 100.0 - #tempCycleTime * #zMoveOffset / 100.0) / 1000.0;
	                        #tempTime[6] := #lineSpeed * #tempCycleTime * #yMoveRatio / 100.0 / 1000.0;
	                        #tempTime[7] := #lineSpeed * (#tempCycleTime - #fwdStartPos - #tempCycleTime * #yMoveRatio / 100.0) / 1000.0;
	                        #tempTime[8] := 0.0;
	                    END_REGION
	                ELSE
	                    IF #ratioOption THEN
	                        REGION RATIO
	                            #tempTime[1] := 0.0;
	                            #tempTime[2] := #lineSpeed * #tempCycleTime / 1000.0;
	                            #tempTime[3] := #lineSpeed * #tempCycleTime * #bwdStartRatio / 100.0 / 1000.0;
	                            #tempTime[4] := #lineSpeed * #tempCycleTime * (#bwdEndRatio - #bwdStartRatio) / 100.0 / 1000.0;
	                            #tempTime[5] := #lineSpeed * #tempCycleTime * (#fwdStartRatio - #bwdEndRatio) / 100.0 / 1000.0;
	                            #tempTime[6] := #lineSpeed * #tempCycleTime * (#fwdEndRatio - #fwdStartRatio) / 100.0 / 1000.0;
	                            #tempTime[7] := #lineSpeed * #tempCycleTime * (100.0 - #fwdEndRatio) / 100.0 / 1000.0;
	                            #tempTime[8] := 0.0;
	                        END_REGION
	                    ELSE
	                        IF #timeOption THEN
	                            REGION TIME
	                                #tempTime[1] := 0.0;
	                                #tempTime[2] := #lineSpeed * #tempCycleTime / 1000.0;
	                                #tempTime[3] := #lineSpeed * #bwdStartTime / 1000.0;
	                                #tempTime[4] := #lineSpeed * (#bwdEndTime - #bwdStartTime) / 1000.0;
	                                #tempTime[5] := #lineSpeed * (#fwdStartTime - #bwdEndTime) / 1000.0;
	                                #tempTime[6] := #lineSpeed * (#fwdEndTime - #fwdStartTime) / 1000.0;
	                                #tempTime[7] := #lineSpeed * (#tempCycleTime - #fwdEndTime) / 1000.0;
	                                #tempTime[8] := 0.0;
	                            END_REGION
	                        END_IF;
	                    END_IF;
	                END_IF;
	                
	                // Calculate Pos
	                #tempPos[1] := 0.0;
	                #tempPos[2] := 0.0;
	                #tempPos[3] := 0.0;
	                #tempPos[4] := - #distance;
	                #tempPos[5] := 0.0;
	                #tempPos[6] := #distance;
	                #tempPos[7] := 0.0;
	                #tempPos[8] := 0.0;
	                
	                // Calculate New Vel
	                #tempVel[1] := 0.0;
	                #tempVel[2] := 0.0;
	                #tempVel[3] := 0.0;
	                #tempVel[4] := 2.0 * #tempPos[4] / (#tempTime[4] * (2.0 - 2.0 / LINT_TO_LREAL(#accRatio)));
	                #tempVel[5] := 0.0;
	                #tempVel[6] := 2.0 * #tempPos[6] / (#tempTime[6] * (2.0 - 2.0 / LINT_TO_LREAL(#accRatio)));
	                #tempVel[7] := 0.0;
	                #tempVel[8] := 0.0;
	                
	                // Calculate Acc
	                #tempAcc[1] := 0.0;
	                #tempAcc[2] := 0.0;
	                #tempAcc[3] := 0.0;
	                #tempAcc[4] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempVel[4] / #tempTime[4];
	                #tempAcc[5] := 0.0;
	                #tempAcc[6] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempVel[6] / #tempTime[6];
	                #tempAcc[7] := 0.0;
	                #tempAcc[8] := 0.0;
	                
	                // Calculate Jerk
	                #tempJerk[1] := 0.0;
	                #tempJerk[2] := 0.0;
	                #tempJerk[3] := 0.0;
	                #tempJerk[4] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[4] / #tempTime[4];
	                #tempJerk[5] := - LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[4] / #tempTime[4];
	                #tempJerk[6] := 0.0;
	                #tempJerk[7] := - LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[4] / #tempTime[4];
	                #tempJerk[8] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[4] / #tempTime[4];
	                #tempJerk[9] := 0.0;
	                #tempJerk[10] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[6] / #tempTime[6];
	                #tempJerk[11] := - LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[6] / #tempTime[6];
	                #tempJerk[12] := 0.0;
	                #tempJerk[13] := - LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[6] / #tempTime[6];
	                #tempJerk[14] := LINT_TO_LREAL(#accRatio) * 2.0 * #tempAcc[6] / #tempTime[6];
	                #tempJerk[15] := 0.0;
	                #tempJerk[16] := 0.0;
	                
	                // Calculate X
	                #tempX[1] := #tempTime[1];
	                #tempX[2] := #tempTime[2];
	                #tempX[3] := #tempTime[3];
	                #tempX[4] := #tempTime[4] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                #tempX[5] := #tempTime[4] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                #tempX[6] := #tempTime[4] * (1.0 - 2.0 / LINT_TO_LREAL(#accRatio));
	                #tempX[7] := #tempTime[4] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                #tempX[8] := #tempTime[4] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                #tempX[9] := #tempTime[5];
	                #tempX[10] := #tempTime[6] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                #tempX[11] := #tempTime[6] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                #tempX[12] := #tempTime[6] * (1.0 - 2.0 / LINT_TO_LREAL(#accRatio));
	                #tempX[13] := #tempTime[6] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                #tempX[14] := #tempTime[6] / (LINT_TO_LREAL(#accRatio) * 2.0);
	                #tempX[15] := #tempTime[7];
	                #tempX[16] := #tempTime[8];
	                
	                // ==============================================================================
	                // Segment [1]
	                // ==============================================================================                           
	                #tempCalAcc[1] := 0.0;
	                #tempCalVel[1] := 0.0;
	                #tempCalPos[1] := 0.0;
	                #tempA3[1] := #tempJerk[1] / 6.0;
	                #tempA2[1] := #tempCalAcc[1] / 2.0;
	                #tempA1[1] := #tempCalVel[1];
	                #tempA0[1] := #tempCalPos[1];
	                #tempCam^.Segment[1].a4 := 0.0;
	                #tempCam^.Segment[1].a5 := 0.0;
	                #tempCam^.Segment[1].a6 := 0.0;
	                #tempCam^.Segment[1].xmax := #tempX[1];
	                #tempCam^.Segment[1].xmin := 0.0;
	                #tempCam^.Segment[1].sineAmplitude := 0.0;
	                #tempCam^.Segment[1].sinePeriod := 0.0;
	                #tempCam^.Segment[1].sinePhase := 0.0;
	                IF #tempX[1] = 0.0 THEN
	                    #tempCam^.ValidSegment[1] := FALSE;
	                ELSE
	                    #tempCam^.ValidSegment[1] := TRUE;
	                END_IF;
	                
	                // ==============================================================================
	                // Segment [2]
	                // ==============================================================================
	                #tempCalAcc[2] := #tempJerk[2 - 1] * #tempX[2 - 1] + #tempCalAcc[2 - 1];
	                #tempCalVel[2] := #tempJerk[2 - 1] * #tempX[2 - 1] * #tempX[2 - 1] / 2.0 + #tempCalAcc[2 - 1] * #tempX[2 - 1] + #tempCalVel[2 - 1];
	                #tempCalPos[2] := #tempJerk[2 - 1] * #tempX[2 - 1] * #tempX[2 - 1] * #tempX[2 - 1] / 6.0 + #tempCalAcc[2 - 1] * #tempX[2 - 1] * #tempX[2 - 1] / 2.0 + #tempCalVel[2 - 1] * #tempX[2 - 1] + #tempCalPos[2 - 1];
	                IF ABS_LREAL(#tempCalVel[2]) < 0.000000001 THEN
	                    #tempCalVel[2] := 0.0;
	                END_IF;
	                IF ABS_LREAL(#tempCalPos[2]) < 0.000000001 THEN
	                    #tempCalPos[2] := 0.0;
	                END_IF;
	                #tempA3[2] := #tempJerk[2] / 6.0;
	                #tempA2[2] := #tempCalAcc[2] / 2.0;
	                #tempA1[2] := #tempCalVel[2];
	                #tempA0[2] := #tempCalPos[2];
	                #tempCam^.Segment[2].a0 := #tempA0[2];
	                #tempCam^.Segment[2].a1 := #tempA1[2];
	                #tempCam^.Segment[2].a2 := #tempA2[2];
	                #tempCam^.Segment[2].a3 := #tempA3[2];
	                #tempCam^.Segment[2].a4 := 0.0;
	                #tempCam^.Segment[2].a5 := 0.0;
	                #tempCam^.Segment[2].a6 := 0.0;
	                #tempCam^.Segment[2].xmax := #tempCam^.Segment[2 - 1].xmax + #tempX[2];
	                #tempCam^.Segment[2].xmin := #tempCam^.Segment[2 - 1].xmax;
	                #tempCam^.Segment[2].sineAmplitude := 0.0;
	                #tempCam^.Segment[2].sinePeriod := 0.0;
	                #tempCam^.Segment[2].sinePhase := 0.0;
	                IF #tempX[2] = 0.0 THEN
	                    #tempCam^.ValidSegment[2] := FALSE;
	                ELSE
	                    #tempCam^.ValidSegment[2] := TRUE;
	                END_IF;
	                
	                
	                // ==============================================================================
	                // Segment [3]
	                // ==============================================================================                           
	                #tempCalAcc[3] := #tempJerk[3 - 1] * #tempX[3 - 1] + #tempCalAcc[3 - 1];
	                #tempCalVel[3] := #tempJerk[3 - 1] * #tempX[3 - 1] * #tempX[3 - 1] / 2.0 + #tempCalAcc[3 - 1] * #tempX[3 - 1] + #tempCalVel[3 - 1];
	                #tempCalPos[3] := #tempJerk[3 - 1] * #tempX[3 - 1] * #tempX[3 - 1] * #tempX[3 - 1] / 6.0 + #tempCalAcc[3 - 1] * #tempX[3 - 1] * #tempX[3 - 1] / 2.0 + #tempCalVel[3 - 1] * #tempX[3 - 1] + #tempCalPos[3 - 1];
	                IF ABS_LREAL(#tempCalVel[3]) < 0.000000001 THEN
	                    #tempCalVel[3] := 0.0;
	                END_IF;
	                IF ABS_LREAL(#tempCalPos[3]) < 0.000000001 THEN
	                    #tempCalPos[3] := 0.0;
	                END_IF;
	                #tempA3[3] := #tempJerk[3] / 6.0;
	                #tempA2[3] := #tempCalAcc[3] / 2.0;
	                #tempA1[3] := #tempCalVel[3];
	                #tempA0[3] := #tempCalPos[3];
	                #tempCam^.Segment[3].a0 := #tempA0[3];
	                #tempCam^.Segment[3].a1 := #tempA1[3];
	                #tempCam^.Segment[3].a2 := #tempA2[3];
	                #tempCam^.Segment[3].a3 := #tempA3[3];
	                #tempCam^.Segment[3].a4 := 0.0;
	                #tempCam^.Segment[3].a5 := 0.0;
	                #tempCam^.Segment[3].a6 := 0.0;
	                #tempCam^.Segment[3].xmax := #tempCam^.Segment[3 - 1].xmax + #tempX[3];
	                #tempCam^.Segment[3].xmin := #tempCam^.Segment[3 - 1].xmax;
	                #tempCam^.Segment[3].sineAmplitude := 0.0;
	                #tempCam^.Segment[3].sinePeriod := 0.0;
	                #tempCam^.Segment[3].sinePhase := 0.0;
	                IF #tempX[3] = 0.0 THEN
	                    #tempCam^.ValidSegment[3] := FALSE;
	                ELSE
	                    #tempCam^.ValidSegment[3] := TRUE;
	                END_IF;
	                
	                
	                // ==============================================================================
	                // Segment [4]
	                // ==============================================================================
	                #tempCalAcc[4] := #tempJerk[4 - 1] * #tempX[4 - 1] + #tempCalAcc[4 - 1];
	                #tempCalVel[4] := #tempJerk[4 - 1] * #tempX[4 - 1] * #tempX[4 - 1] / 2.0 + #tempCalAcc[4 - 1] * #tempX[4 - 1] + #tempCalVel[4 - 1];
	                #tempCalPos[4] := #tempJerk[4 - 1] * #tempX[4 - 1] * #tempX[4 - 1] * #tempX[4 - 1] / 6.0 + #tempCalAcc[4 - 1] * #tempX[4 - 1] * #tempX[4 - 1] / 2.0 + #tempCalVel[4 - 1] * #tempX[4 - 1] + #tempCalPos[4 - 1];
	                IF ABS_LREAL(#tempCalVel[4]) < 0.000000001 THEN
	                    #tempCalVel[4] := 0.0;
	                END_IF;
	                IF ABS_LREAL(#tempCalPos[4]) < 0.000000001 THEN
	                    #tempCalPos[4] := 0.0;
	                END_IF;
	                #tempA3[4] := #tempJerk[4] / 6.0;
	                #tempA2[4] := #tempCalAcc[4] / 2.0;
	                #tempA1[4] := #tempCalVel[4];
	                #tempA0[4] := #tempCalPos[4];
	                #tempCam^.Segment[4].a0 := #tempA0[4];
	                #tempCam^.Segment[4].a1 := #tempA1[4];
	                #tempCam^.Segment[4].a2 := #tempA2[4];
	                #tempCam^.Segment[4].a3 := #tempA3[4];
	                #tempCam^.Segment[4].a4 := 0.0;
	                #tempCam^.Segment[4].a5 := 0.0;
	                #tempCam^.Segment[4].a6 := 0.0;
	                #tempCam^.Segment[4].xmax := #tempCam^.Segment[4 - 1].xmax + #tempX[4];
	                #tempCam^.Segment[4].xmin := #tempCam^.Segment[4 - 1].xmax;
	                #tempCam^.Segment[4].sineAmplitude := 0.0;
	                #tempCam^.Segment[4].sinePeriod := 0.0;
	                #tempCam^.Segment[4].sinePhase := 0.0;
	                IF #tempX[4] = 0.0 THEN
	                    #tempCam^.ValidSegment[4] := FALSE;
	                ELSE
	                    #tempCam^.ValidSegment[4] := TRUE;
	                END_IF;
	                
	                
	                // ==============================================================================
	                // Segment [5]
	                // ==============================================================================
	                #tempCalAcc[5] := #tempJerk[5 - 1] * #tempX[5 - 1] + #tempCalAcc[5 - 1];
	                #tempCalVel[5] := #tempJerk[5 - 1] * #tempX[5 - 1] * #tempX[5 - 1] / 2.0 + #tempCalAcc[5 - 1] * #tempX[5 - 1] + #tempCalVel[5 - 1];
	                #tempCalPos[5] := #tempJerk[5 - 1] * #tempX[5 - 1] * #tempX[5 - 1] * #tempX[5 - 1] / 6.0 + #tempCalAcc[5 - 1] * #tempX[5 - 1] * #tempX[5 - 1] / 2.0 + #tempCalVel[5 - 1] * #tempX[5 - 1] + #tempCalPos[5 - 1];
	                IF ABS_LREAL(#tempCalVel[5]) < 0.000000001 THEN
	                    #tempCalVel[5] := 0.0;
	                END_IF;
	                IF ABS_LREAL(#tempCalPos[5]) < 0.000000001 THEN
	                    #tempCalPos[5] := 0.0;
	                END_IF;
