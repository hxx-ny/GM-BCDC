	                // ==============================================================================
	                #tempCalAcc[16] := #tempJerk[16 - 1] * #tempX[16 - 1] + #tempCalAcc[16 - 1];
	                #tempCalVel[16] := #tempJerk[16 - 1] * #tempX[16 - 1] * #tempX[16 - 1] / 2.0 + #tempCalAcc[16 - 1] * #tempX[16 - 1] + #tempCalVel[16 - 1];
	                #tempCalPos[16] := #tempJerk[16 - 1] * #tempX[16 - 1] * #tempX[16 - 1] * #tempX[16 - 1] / 6.0 + #tempCalAcc[16 - 1] * #tempX[16 - 1] * #tempX[16 - 1] / 2.0 + #tempCalVel[16 - 1] * #tempX[16 - 1] + #tempCalPos[16 - 1];
	                IF ABS_LREAL(#tempCalVel[16]) < 0.000000001 THEN
	                    #tempCalVel[16] := 0.0;
	                END_IF;
	                IF ABS_LREAL(#tempCalPos[16]) < 0.000000001 THEN
	                    #tempCalPos[16] := 0.0;
	                END_IF;
	                #tempA3[16] := #tempJerk[16] / 6.0;
	                #tempA2[16] := #tempCalAcc[16] / 2.0;
	                #tempA1[16] := #tempCalVel[16];
	                #tempA0[16] := #tempCalPos[16];
	                #tempCam^.Segment[16].a0 := #tempA0[16];
	                #tempCam^.Segment[16].a1 := #tempA1[16];
	                #tempCam^.Segment[16].a2 := #tempA2[16];
	                #tempCam^.Segment[16].a3 := #tempA3[16];
	                #tempCam^.Segment[16].a4 := 0.0;
	                #tempCam^.Segment[16].a5 := 0.0;
	                #tempCam^.Segment[16].a6 := 0.0;
	                #tempCam^.Segment[16].xmax := #tempCam^.Segment[16 - 1].xmax + #tempX[16];
	                #tempCam^.Segment[16].xmin := #tempCam^.Segment[16 - 1].xmax;
	                #tempCam^.Segment[16].sineAmplitude := 0.0;
	                #tempCam^.Segment[16].sinePeriod := 0.0;
	                #tempCam^.Segment[16].sinePhase := 0.0;
	                IF #tempX[16] = 0.0 THEN
	                    #tempCam^.ValidSegment[16] := FALSE;
	                ELSE
	                    #tempCam^.ValidSegment[16] := TRUE;
	                END_IF;
	                #statEndTime := TIME_TCK();
	                #statTimeTable[#CC_CALCULATE] := #statEndTime - #statStartTime;
	                #statStartTime := TIME_TCK();
	                #statCalculateCamState := #CC_INTERPOLATE;
	            END_REGION
	            
	        #CC_INTERPOLATE:
	            REGION INTERPOLATE
	                IF #instMCInterpolateCam.Done
	                THEN
	                    #statEndTime := TIME_TCK();
	                    #statTimeTable[#CC_INTERPOLATE] := #statEndTime - #statStartTime;
	                    #statStartTime := TIME_TCK();
	                    #statCalculateCamState := #CC_DONE;
	                END_IF;
	            END_REGION
	            
	        #CC_DONE:
	            REGION DONE
	                ;
	            END_REGION
	            
	        #CC_ERROR:
	            REGION ERROR
	                ;
	            END_REGION
	    END_CASE;
	END_REGION
	
	REGION Instance
	    #instMCInterpolateCam(Cam := #tempCam^,
	                          Execute := #statCalculateCamState = #CC_INTERPOLATE);
	    #instMCCopyCamData(Cam := #tempCam^,
	                       Execute := #statCalculateCamState = #CC_INITIALIZE1 OR #statCalculateCamState = #CC_INITIALIZE3,
	                       Mode := 0,
	                       StartPointCam := 1,
	                       StartSegmentCam := 1,
	                       StartPointArray := 1,
	                       StartSegmentArray := 1,
	                       ArrayOfPoints := #EmptyPoint,
	                       ArrayOfSegments := #EmptySegment);
	END_REGION
	REGION Outputs
	    #busy := #statCalculateCamState = #CC_INITIALIZE1
	    OR #statCalculateCamState = #CC_INITIALIZE2
	    OR #statCalculateCamState = #CC_INITIALIZE3
	    OR #statCalculateCamState = #CC_CALCULATE
	    OR #statCalculateCamState = #CC_INTERPOLATE;
	    #error := #statCalculateCamState = #CC_ERROR;
	    #done := #statCalculateCamState = #CC_DONE;
	END_REGION
END_FUNCTION_BLOCK

