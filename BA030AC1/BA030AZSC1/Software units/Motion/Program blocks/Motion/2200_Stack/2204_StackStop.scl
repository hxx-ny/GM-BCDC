	        #STAT_HOME:
	            REGION HOME
	                REGION DONE
	                    IF #instHomeMasterVirtual.Done THEN                                   //가상축 홈 동작 완료시
	                        #statEndTime := TIME_TCK();
	                        #statTimeTable[#STAT_HOME / 10 - 9] := #statEndTime - #statStartTime;
	                        #statStartTime := TIME_TCK();
	                        #statBeforeCmd := #statNowCmd;                                    // 이전 명령 모니터링
	                        #statNowCmd := #STAT_DONE;                                    // STAT_DONE 상태 돌입
	                    END_IF;
	                END_REGION
	                
	                REGION ERROR                                                              // 가상축 홈 동작 중 에러 발생 시
	                    IF #instHomeMasterVirtual.Error THEN
	                        #ErrorID := #instHomeMasterVirtual.ErrorId;                       // 에러ID 출력
	                        #statBeforeCmd := #statNowCmd;                                    // 이전 명령 모니터링
	                        #statNowCmd := #STAT_ERROR;                                       // STAT_ERROR 상태 돌입
	                    END_IF;
	                END_REGION
	            END_REGION
	            
	        #STAT_DONE:
	            REGION DONE
	                ;
	            END_REGION
	    END_CASE;
	END_REGION
	
	REGION INSTANCES
	    REGION MASTER VIRTUAL
	        #tempLineSpeed := #StageWidth * #CPM / 60.0;                                                             // Master Virtual 선속 [mm/s] 계산
	        #tempTime := 60.0 / #CPM;                                                                                // Master Virtual 구동 시간[s] 계산
	        
	        #instMoveAbsMasterVirtual(Axis := #tempMasterVirtual^,
	                                  Execute := #statNowCmd = #STAT_MASTER,
	                                  Position := #statPosition,
	                                  Velocity := #tempLineSpeed,
	                                  Acceleration := 4.0 * #tempLineSpeed / #tempTime,
	                                  Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                                  Jerk := 0.0,
	                                  BufferMode := 0,
	                                  Direction := 1);
	        #instHaltMasterVirtual(Axis := #tempMasterVirtual^,
	                               Execute := #statNowCmd = #STAT_ALL,
	                               Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                               Jerk := 0.0,
	                               AbortAcceleration := FALSE,
	                               Mode := 0);
	        #instHomeMasterVirtual(Axis := #tempMasterVirtual^,                           // 마스터 가상축 지정
	                               Execute := #statNowCmd = #STAT_HOME,                   //  STAT_Home 상태일 때
	                               Position := 0.0,
	                               Mode := 0,
	                               Sensor := 0);
	        
	        
	    END_REGION
	    
	    REGION UNWINDER VIRTUAL
	        #instHaltSlaveUnwinderVirtual(Axis := #tempSlaveUnwinderVirtual^,
	                                      Execute := #statNowCmd = #STAT_ALL OR #statNowCmd = #STAT_UNWINDER,
	                                      Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                                      Jerk := 0.0,
	                                      AbortAcceleration := FALSE,
	                                      Mode := 0);
	    END_REGION
	    
	    REGION FINAL ROLLER
	        #tempSynchronousAxis ?= #Axis.FinalRoller;
	        #instHaltFinalRoller(Axis := #tempSynchronousAxis^,
	                             Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                             Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                             Jerk := 0.0,
	                             AbortAcceleration := FALSE,
	                             Mode := 0);
	    END_REGION
	    
	    REGION COMPENSATOR
	        #tempSynchronousAxis ?= #Axis.Compensator;
	        #instHaltCompensator(Axis := #tempSynchronousAxis^,
	                             Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                             Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                             Jerk := 0.0,
	                             AbortAcceleration := FALSE,
	                             Mode := 0);
	    END_REGION
	    
	    REGION ANODE PNP X1
	        #tempSynchronousAxis ?= #Axis.AnodePnPX1;
	        #instHaltAnodePnPX1(Axis := #tempSynchronousAxis^,
	                            Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                            Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                            Jerk := 0.0,
	                            AbortAcceleration := FALSE,
	                            Mode := 0);
	    END_REGION
	    
	    REGION ANODE PNP X2
	        #tempSynchronousAxis ?= #Axis.AnodePnPX2;
	        #instHaltAnodePnPX2(Axis := #tempSynchronousAxis^,
	                            Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                            Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                            Jerk := 0.0,
	                            AbortAcceleration := FALSE,
	                            Mode := 0);
	    END_REGION
	    
	    REGION ANODE PNP Z1
	        #tempSynchronousAxis ?= #Axis.AnodePnPZ1;
	        #instHaltAnodePnPZ1(Axis := #tempSynchronousAxis^,
	                            Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                            Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                            Jerk := 0.0,
	                            AbortAcceleration := FALSE,
	                            Mode := 0);
	    END_REGION
	    
	    REGION ANODE PNP Z2
	        #tempSynchronousAxis ?= #Axis.AnodePnPZ2;
	        #instHaltAnodePnPZ2(Axis := #tempSynchronousAxis^,
