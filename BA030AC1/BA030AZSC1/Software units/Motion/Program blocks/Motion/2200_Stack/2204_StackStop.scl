	                            Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                            Jerk := 0.0,
	                            AbortAcceleration := FALSE,
	                            Mode := 0);
	    END_REGION
	    
	    REGION CATHODE PNP X1
	        #tempSynchronousAxis ?= #Axis.CathodePnPX1;
	        #instHaltCathodePnPX1(Axis := #tempSynchronousAxis^,
	                              Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                              Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                              Jerk := 0.0,
	                              AbortAcceleration := FALSE,
	                              Mode := 0);
	    END_REGION
	    
	    REGION CATHODE PNP X2
	        #tempSynchronousAxis ?= #Axis.CathodePnPX2;
	        #instHaltCathodePnPX2(Axis := #tempSynchronousAxis^,
	                              Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                              Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                              Jerk := 0.0,
	                              AbortAcceleration := FALSE,
	                              Mode := 0);
	    END_REGION
	    
	    REGION CATHODE PNP Z1
	        #tempSynchronousAxis ?= #Axis.CathodePnPZ1;
	        #instHaltCathodePnPZ1(Axis := #tempSynchronousAxis^,
	                              Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                              Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                              Jerk := 0.0,
	                              AbortAcceleration := FALSE,
	                              Mode := 0);
	    END_REGION
	    
	    REGION CATHODE PNP Z2
	        #tempSynchronousAxis ?= #Axis.CathodePnPZ2;
	        #instHaltCathodePnPZ2(Axis := #tempSynchronousAxis^,
	                              Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                              Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                              Jerk := 0.0,
	                              AbortAcceleration := FALSE,
	                              Mode := 0);
	    END_REGION
	    
	    REGION ANODE MANDREL Y FRONT
	        #tempSynchronousAxis ?= #Axis.AnodeMandrelYFront;
	        #instHaltAnodeMandrelYFront(Axis := #tempSynchronousAxis^,
	                                    Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                                    Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                                    Jerk := 0.0,
	                                    AbortAcceleration := FALSE,
	                                    Mode := 0);
	    END_REGION
	    
	    REGION ANODE MANDREL Y REAR
	        #tempSynchronousAxis ?= #Axis.AnodeMandrelYRear;
	        #instHaltAnodeMandrelYRear(Axis := #tempSynchronousAxis^,
	                                   Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                                   Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                                   Jerk := 0.0,
	                                   AbortAcceleration := FALSE,
	                                   Mode := 0);
	    END_REGION
	    
	    REGION ANODE MANDREL Z FRONT
	        #tempSynchronousAxis ?= #Axis.AnodeMandrelZFront;
	        #instHaltAnodeMandrelZFront(Axis := #tempSynchronousAxis^,
	                                    Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                                    Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                                    Jerk := 0.0,
	                                    AbortAcceleration := FALSE,
	                                    Mode := 0);
	    END_REGION
	    
	    REGION ANODE MANDREL Z REAR
	        #tempSynchronousAxis ?= #Axis.AnodeMandrelZRear;
	        #instHaltAnodeMandrelZRear(Axis := #tempSynchronousAxis^,
	                                   Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                                   Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                                   Jerk := 0.0,
	                                   AbortAcceleration := FALSE,
	                                   Mode := 0);
	    END_REGION
	    
	    REGION CATHODE MANDREL Y FRONT
	        #tempSynchronousAxis ?= #Axis.CathodeMandrelYFront;
	        #instHaltCathodeMandrelYFront(Axis := #tempSynchronousAxis^,
	                                      Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                                      Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                                      Jerk := 0.0,
	                                      AbortAcceleration := FALSE,
	                                      Mode := 0);
	    END_REGION
	    
	    REGION CATHODE MANDREL Y REAR
	        #tempSynchronousAxis ?= #Axis.CathodeMandrelYRear;
	        #instHaltCathodeMandrelYRear(Axis := #tempSynchronousAxis^,
	                                     Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                                     Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                                     Jerk := 0.0,
	                                     AbortAcceleration := FALSE,
	                                     Mode := 0);
	    END_REGION
	    
	    REGION CATHODE MANDREL Z FRONT
	        #tempSynchronousAxis ?= #Axis.CathodeMandrelZFront;
	        #instHaltCathodeMandrelZFront(Axis := #tempSynchronousAxis^,
	                                      Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                                      Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                                      Jerk := 0.0,
	                                      AbortAcceleration := FALSE,
	                                      Mode := 0);
	    END_REGION
	    
	    REGION CATHODE MANDREL Z REAR
	        #tempSynchronousAxis ?= #Axis.CathodeMandrelZRear;
	        #instHaltCathodeMandrelZRear(Axis := #tempSynchronousAxis^,
	                                     Execute := #statNowCmd = #STAT_OTHERS OR #statNowCmd = #STAT_ALL,
	                                     Deceleration := 4.0 * #tempLineSpeed / #tempTime,
	                                     Jerk := 0.0,
	                                     AbortAcceleration := FALSE,
	                                     Mode := 0);
	    END_REGION
	END_REGION
	
	REGION OUTPUT SIGNAL                                                                                             // 각 커맨드 동작 시 상태 표시 출력
	    #Busy := #statNowCmd = #STAT_START
	    OR #statNowCmd = #STAT_AUTO_CHECK
	    OR #statNowCmd = #STAT_UNWINDER
	    OR #statNowCmd = #STAT_MASTER
	    OR #statNowCmd = #STAT_OTHERS
	    OR #statNowCmd = #STAT_ALL;
	    #Done := #statNowCmd = #STAT_DONE;
	    #Error := #statNowCmd = #STAT_ERROR;
	    #NowCmd := #statNowCmd;
	    #BeforeCmd := #statBeforeCmd;
	END_REGION
	
END_FUNCTION_BLOCK

